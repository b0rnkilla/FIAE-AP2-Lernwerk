@if (Question.Illustration.Length > 0)
{
    <figure class="business-illustration">
        <svg viewBox="0 0 640 230" role="img" aria-label="@Question.IllustrationDescription" xmlns="http://www.w3.org/2000/svg">
            @if (Question.Illustration == "warning")
            {
                <path d="M320 20 L425 205 H215 Z" fill="#ffd43b" stroke="#141c28" stroke-width="9" stroke-linejoin="round" />
                <path d="M320 82 V144" stroke="#141c28" stroke-width="14" stroke-linecap="round" /><circle cx="320" cy="175" r="8" fill="#141c28" />
            }
            else if (Question.Illustration == "mandatory")
            {
                <circle cx="320" cy="115" r="96" fill="#205bc4" />
            }
            else if (Question.Illustration == "matrix")
            {
                <g>
                <path d="M290 47 V170 M160 165 H400" class="business-chart-line" />
                <rect x="200" y="15" width="180" height="40" rx="8" /><text x="290" y="41" text-anchor="middle">Entwicklung</text>
                <rect x="15" y="145" width="160" height="40" rx="8" /><text x="95" y="171" text-anchor="middle">Projekt Nord</text>
                <rect x="245" y="145" width="180" height="40" rx="8" /><text x="335" y="171" text-anchor="middle">Team</text>
                </g>
            }
            else
            {
                <g>
                <path d="M320 65 V95 H160 V135 M320 95 H480 V135 M160 175 V205 M480 175 V205" class="business-chart-line" />
                <rect x="235" y="25" width="170" height="40" rx="8" /><text x="320" y="51" text-anchor="middle">Geschäftsführung</text>
                <rect x="75" y="135" width="170" height="40" rx="8" /><text x="160" y="161" text-anchor="middle">Entwicklung</text>
                <rect x="395" y="135" width="170" height="40" rx="8" /><text x="480" y="161" text-anchor="middle">Service</text>
                <text x="160" y="225" text-anchor="middle">Team A</text><text x="480" y="225" text-anchor="middle">Team B</text>
                @if (Question.Illustration == "staff")
                {
                    <g><path d="M405 45 H460" class="business-chart-line" stroke-dasharray="5 5" /><ellipse cx="535" cy="45" rx="75" ry="25" /><text x="535" y="51" text-anchor="middle">Rechtsstelle</text></g>
                }
                </g>
            }
        </svg>
        <figcaption>@Question.IllustrationDescription</figcaption>
    </figure>
}

@code {
    /// <summary> Aufgabe mit der eigenen Abbildung und einer vollständigen Beschreibung. </summary>
    [Parameter, EditorRequired] public BusinessQuestion Question { get; set; } = default!;
}
