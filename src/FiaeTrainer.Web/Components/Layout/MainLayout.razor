@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject LearningNavigation LearningNavigation
@inject NetworkAccessPolicy NetworkAccess
@inject AppVersionInfo Version
<a class="skip-link" href="@(Navigation.Uri.Split('#')[0] + "#inhalt")">Zum Inhalt</a>
<header class="topbar">
    <a class="brand" href="/" aria-label="AP2 Lernwerk – zur Übersicht"><span class="brand-symbol">a<span>2</span></span><span>AP2 <strong>Lernwerk</strong><small>FACHINFORMATIK · ANWENDUNGSENTWICKLUNG</small></span></a>
    <nav aria-label="Hauptnavigation">
        <NavLink href="/" Match="NavLinkMatch.All">Übersicht</NavLink>
        <NavLink href="lernplan">Lernplan</NavLink>
        @if (LearningNavigation.Algorithms)
        {
            <a href="/algorithmen" class="@(AlgorithmTrainingActive ? "active" : null)" aria-current="@(AlgorithmTrainingActive ? "page" : null)">Algorithmen-Training</a>
            <NavLink href="algorithmen/pruefung">Prüfung üben</NavLink>
            <NavLink href="@(InExam ? "/algorithmen/spickzettel?pruefung=true" : "/algorithmen/spickzettel")">Pseudocode-Spickzettel</NavLink>
        }
        else if (LearningNavigation.Module == LearningModule.SoftwareDesign)
        {
            <NavLink href="softwareplanung" Match="NavLinkMatch.All">Softwareplanung lernen</NavLink>
            <NavLink href="softwareplanung/pruefung">Prüfung üben</NavLink>
            <NavLink href="@(InExam ? "/softwareplanung/spickzettel?pruefung=true" : "/softwareplanung/spickzettel")">Entwurfs-Spickzettel</NavLink>
        }
        else if (LearningNavigation.Module == LearningModule.Uml)
        {
            <NavLink href="uml" Match="NavLinkMatch.All">UML lernen</NavLink>
            <NavLink href="uml/pruefung">Prüfung üben</NavLink>
            <NavLink href="@(InExam ? "/uml/spickzettel?pruefung=true" : "/uml/spickzettel")">UML-Spickzettel</NavLink>
        }
        else if (LearningNavigation.Module == LearningModule.DatabaseDesign)
        {
            <NavLink href="datenbankentwurf" Match="NavLinkMatch.All">Entwurf lernen</NavLink>
            <NavLink href="datenbankentwurf/pruefung">Prüfung üben</NavLink>
            <NavLink href="@(InExam ? "/datenbankentwurf/spickzettel?pruefung=true" : "/datenbankentwurf/spickzettel")">Entwurf-Spickzettel</NavLink>
        }
        else if (LearningNavigation.Module == LearningModule.BusinessStudies)
        {
            <NavLink href="wiso" Match="NavLinkMatch.All">WiSo-Training</NavLink>
            <NavLink href="wiso/pruefung">Prüfung üben</NavLink>
            <NavLink href="wiso/spickzettel">WiSo-Spickzettel</NavLink>
        }
        else
        {
            <a href="/sql" class="@(SqlTrainingActive ? "active" : null)" aria-current="@(SqlTrainingActive ? "page" : null)">SQL-Ermittlung</a>
            <NavLink href="sql-werkstatt">SQL-Werkstatt</NavLink>
            <NavLink href="sql/pruefung">Prüfung üben</NavLink>
            <NavLink href="@(InExam ? "/nachschlagen?pruefung=true" : LearningNavigation.SqlReferenceHref)">SQL-Spickzettel</NavLink>
        }
    </nav>
    <label class="theme-choice"><span>Darstellung</span><select aria-label="Darstellung" data-theme-selector><option value="system">System</option><option value="light">Hell</option><option value="dark">Dunkel</option></select></label>
</header>
@if (NetworkAccess.AllowLan)
{
    <aside class="network-notice" aria-label="Heimnetz-Modus"><strong>Heimnetz aktiv</strong> Alle verbundenen Geräte teilen sich diesen Lernstand. <a href="/heimnetz" data-enhance-nav="false">Heimnetz-Einstellung</a></aside>
}
<UpdateNotice />
<div id="inhalt">@Body</div>
<footer class="site-footer">
    <div class="footer-information"><a href="/einrichtung">Version @Version.Display@(Version.IsPrerelease ? " · Testversion" : "")</a><span>Eigene Übungsaufgaben · keine offiziellen IHK-Prüfungsaufgaben</span></div>
    <nav class="footer-project-links" aria-label="Projekt und Hilfe">
        <a href="/ueber-das-lernwerk">Über das Lernwerk</a>
        <a href="@ProjectInformation.ISSUES_URL" target="_blank" rel="noopener noreferrer">Fehler oder Vorschlag melden <span aria-hidden="true">↗</span></a>
        @if (ProjectInformation.HasPayPal)
        {
            <a href="@ProjectInformation.PAYPAL_URL" target="_blank" rel="noopener noreferrer" title="Freiwillige Unterstützung über PayPal"><span aria-hidden="true">☕</span> Unterstützen <span aria-hidden="true">↗</span></a>
        }
        <a href="/einrichtung">Updates &amp; SQL-Einrichtung</a>
        <a href="/heimnetz" data-enhance-nav="false">Heimnetz</a>
    </nav>
</footer>

@code {
    /// <summary> Hält den Trainingseintrag auch auf nummerierten Aufgaben aktiv, aber nicht im Spickzettel. </summary>
    private bool AlgorithmTrainingActive => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/') is var path && (path == "algorithmen" || path.StartsWith("algorithmen/", StringComparison.OrdinalIgnoreCase) && int.TryParse(path.Split('/').Last(), out _));
    /// <summary> Prüfungsseiten sind eigene Navigationsziele und aktivieren nicht die Ermittlungsakte. </summary>
    private bool SqlTrainingActive => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/') is var path && (path == "sql" || path.StartsWith("sql/", StringComparison.OrdinalIgnoreCase) && int.TryParse(path.Split('/').Last(), out _));
    /// <summary> Nachschlagen aus einer Prüfungsrunde verwendet den festen Prüfungsrückweg. </summary>
    private bool InExam => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].EndsWith("/pruefung/runde", StringComparison.Ordinal);
    protected override void OnInitialized()
    {
        LearningNavigation.Visit(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.LocationChanged += OnLocationChanged;
    }

    /// <summary> Passt ausschließlich die fachlichen Navigationspunkte an das tatsächlich besuchte Modul an. </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        LearningNavigation.Visit(Navigation.ToBaseRelativePath(args.Location));
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary> Entfernt die Sitzungsanmeldung beim Schließen des Layouts. </summary>
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
