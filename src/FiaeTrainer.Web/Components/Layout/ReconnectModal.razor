@* Statisches HTML und eigene Browserereignisse bleiben auch ohne aktive Blazor-Verbindung bedienbar. *@
<dialog id="components-reconnect-modal" class="reconnect-dialog" aria-labelledby="reconnect-title" aria-describedby="reconnect-message" data-nosnippet>
    <span class="eyebrow">DEIN LERNWERK</span>
    <h2 id="reconnect-title">Verbindung unterbrochen</h2>
    <p id="reconnect-message" role="status" aria-live="polite">Die Verbindung wird wiederhergestellt.<br />Einen Moment bitte.</p>
    <div class="reconnect-actions">
        <button id="reconnect-retry" type="button" class="button primary" hidden>Erneut verbinden</button>
        <button id="reconnect-reload" type="button" class="button secondary">Seite neu laden</button>
    </div>
    <p class="reconnect-note">Beim Neuladen können noch nicht gespeicherte Eingaben verloren gehen.</p>
</dialog>
