<section class="notice @(Result.Correct ? "success" : "warning")" tabindex="-1" aria-label="Bewertung deines Datenmodells">
    <h2>@(Result.Correct ? "Dieser Entwurf trägt." : "Hier kannst du noch nachbessern.")</h2>
    <p>@(Result.Earned * Maximum / 50) / @Maximum Trainingspunkte · eigene Bewertung, keine amtliche IHK-Note</p>
    @foreach (var check in Result.Checks) { <details class="exam-check" open="@(check.Earned < check.Maximum || check.Maximum == 0)"><summary>@check.Name · @(Maximum == 50 ? $"{check.Earned} / {check.Maximum}" : check.Maximum == 0 ? "Zusatzhinweis" : $"{100 * check.Earned / check.Maximum} % erfüllt")</summary><p>@check.Detail</p></details> }
</section>
@code {
    /// <summary> Erst nach ausdrücklichem Prüfen beziehungsweise nach Prüfungsabgabe sichtbar. </summary>
    [Parameter, EditorRequired] public DesignEvaluation Result { get; set; } = new();
    /// <summary> Gewichtet dieselben fachlichen Kriterien bei einer Teilaufgabe mit weniger Punkten. </summary>
    [Parameter] public int Maximum { get; set; } = 50;
}
