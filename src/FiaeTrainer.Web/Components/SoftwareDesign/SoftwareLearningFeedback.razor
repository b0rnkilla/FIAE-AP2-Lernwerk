<section class="feedback @(Result.Correct ? "correct" : "retry")" role="status" aria-label="Rückmeldung zu deiner Lösung"><strong>@(Result.Correct ? "Dieser Entwurf stimmt." : "Schau noch einmal genau hin.")</strong><p>@(Result.Correct ? "Deine fachliche Lösung erfüllt die beschriebenen Anforderungen." : "Vergleiche die offenen Kriterien mit dem Arbeitsauftrag.")</p>
@if (Result.Correct) { <p class="discovery">@Task.Discovery</p><AttemptOutcomeNote ExamMode="IndependentMode" AssistedAttempt="Assisted" /> }
else { <div class="design-checks">@foreach (var check in Result.Checks) { <details open="@(check.Earned != check.Maximum)"><summary>@check.Name · @(check.Earned == check.Maximum ? "erfüllt" : "noch offen")</summary><p>@check.Detail</p></details> }</div> }
</section>
@if (Result.Correct) { <details class="software-reflection"><summary>Deine Begründung selbst überprüfen</summary><p>Diese zusätzliche Schreibübung verändert die automatische Bewertung nicht.</p><ul>@foreach (var criterion in Task.ReflectionCriteria) { <li>@criterion</li> }</ul></details> }
@code {
    /// <summary> Aktuelle fachliche Rückmeldung ohne Lernpunkte. </summary>
    [Parameter, EditorRequired] public SoftwareEvaluation Result { get; set; } = new();
    /// <summary> Erkenntnis und Selbstkontrollkriterien. </summary>
    [Parameter, EditorRequired] public SoftwareAssignment Task { get; set; } = new();
    /// <summary> Gewählter Lernmodus des Versuchs. </summary>
    [Parameter] public bool IndependentMode { get; set; }
    /// <summary> Bereits verwendete Unterstützung. </summary>
    [Parameter] public bool Assisted { get; set; }
}
