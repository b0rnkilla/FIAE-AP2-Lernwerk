@if (Task.Kind == "Choice")
{
    <fieldset class="design-options" disabled="@ReadOnly"><legend>@(Task.CorrectIds.Count == 1 ? "Wähle eine Aussage." : $"Wähle {Task.CorrectIds.Count} Aussagen.")</legend>
    @foreach (var option in Task.Options) { <label><input type="@(Task.CorrectIds.Count == 1 ? "radio" : "checkbox")" name="@_group" checked="@Answer.SelectedIds.Contains(option.Key)" @onchange='() => SelectAsync(option.Key)' /> @option.Value</label> }
    </fieldset>
}
else if (Task.Kind == "Diagram")
{
    <UmlEditor Task="Task.Diagram!" Answer="Answer.Diagram" ReadOnly="ReadOnly" Changed="Changed" />
}
else if (Task.Kind is "Architecture" or "Form")
{
    <SoftwareBoardView Task="Task" Board="Answer.Board" ReadOnly="ReadOnly" />
    <p class="design-caption">Fachrollen legen die Bedeutung fest; eigene Anzeigenamen sind frei. Die Übersicht ordnet automatisch an. @(Task.Kind == "Form" ? "Früher und Später bestimmen die Formularreihenfolge." : "Verbinde die selbst angelegten Bausteine über Ausgang und Ziel.")</p>
    <div class="design-builder-toolbar"><h2>Deine Elemente</h2><button type="button" class="button secondary" disabled="@(ReadOnly || Answer.Board.Nodes.Count >= 16)" @onclick="AddNodeAsync">+ Element hinzufügen</button></div>
    @foreach (var node in Answer.Board.Nodes)
    {
        <fieldset class="uml-node-editor" disabled="@ReadOnly" @key="node.Id"><legend>Element @(Answer.Board.Nodes.IndexOf(node) + 1)</legend><div class="uml-fields">
            <label>Fachrolle<select value="@node.Key" @onchange='args => NodeAsync(node, "Key", args.Value?.ToString() ?? "")'><option value="">Bitte wählen</option>@foreach (var role in Task.NodeVocabulary) { <option value="@role.Key">@role.Value</option> }</select></label>
            <label>Elementart<select value="@node.Kind" @onchange='args => NodeAsync(node, "Kind", args.Value?.ToString() ?? "")'>@foreach (var kind in Task.NodeKinds) { <option value="@kind.Key">@kind.Value</option> }</select></label>
            <label>Anzeigename<input maxlength="80" value="@node.Name" @oninput='args => NodeAsync(node, "Name", args.Value?.ToString() ?? "")' /></label>
            <label>@(Task.Kind == "Form" ? "Formulargruppe" : "Schicht / Zuständigkeit")<select value="@node.Group" @onchange='args => NodeAsync(node, "Group", args.Value?.ToString() ?? "")'><option value="">Bitte wählen</option>@foreach (var group in Task.Groups) { <option value="@group.Key">@group.Value</option> }</select></label>
            @if (Task.Kind == "Form")
            {
                <label class="uml-checkbox"><input type="checkbox" checked="@node.Required" @onchange='args => RequiredAsync(node, args.Value is true)' /> Pflichtfeld</label>
                <label>Hilfetext<input maxlength="200" value="@node.Hint" @oninput='args => NodeAsync(node, "Hint", args.Value?.ToString() ?? "")' /></label>
            }
        </div>
        @if (Task.Kind == "Form") { <div class="uml-order"><button type="button" class="button secondary" disabled="@(Answer.Board.Nodes.IndexOf(node) == 0)" @onclick="() => MoveAsync(node, -1)">↑ Früher</button><button type="button" class="button secondary" disabled="@(Answer.Board.Nodes.IndexOf(node) == Answer.Board.Nodes.Count - 1)" @onclick="() => MoveAsync(node, 1)">↓ Später</button></div> }
        <button type="button" class="design-remove" @onclick="() => RemoveNodeAsync(node)">Element entfernen</button></fieldset>
    }
    @if (Task.Kind == "Architecture")
    {
        <div class="design-builder-toolbar"><h3>Deine Verbindungen</h3><button type="button" class="button secondary" disabled="@(ReadOnly || Answer.Board.Nodes.Count == 0 || Answer.Board.Links.Count >= 32)" @onclick="AddLinkAsync">+ Verbindung hinzufügen</button></div>
        @foreach (var link in Answer.Board.Links)
        {
            <fieldset class="uml-link-editor" disabled="@ReadOnly" @key="link.Id"><legend>Verbindung @(Answer.Board.Links.IndexOf(link) + 1)</legend><div class="uml-fields">
                <label>Ausgang<select value="@link.Source" @onchange='args => LinkAsync(link, "Source", args.Value?.ToString() ?? "")'><option value="">Bitte wählen</option>@foreach (var node in Answer.Board.Nodes) { <option value="@node.Id">@node.Name</option> }</select></label>
                <label>Ziel<select value="@link.Target" @onchange='args => LinkAsync(link, "Target", args.Value?.ToString() ?? "")'><option value="">Bitte wählen</option>@foreach (var node in Answer.Board.Nodes) { <option value="@node.Id">@node.Name</option> }</select></label>
                <label>Verbindungsart<select value="@link.Kind" @onchange='args => LinkAsync(link, "Kind", args.Value?.ToString() ?? "")'>@foreach (var kind in Task.LinkKinds) { <option value="@kind.Key">@kind.Value</option> }</select></label>
            </div><button type="button" class="design-remove" @onclick="() => RemoveLinkAsync(link)">Verbindung entfernen</button></fieldset>
        }
    }
}
else
{
    <fieldset class="software-worksheet" disabled="@ReadOnly"><legend>@(Task.Kind == "Api" ? "Dein Schnittstellenvertrag" : "Deine Ausarbeitung")</legend><div class="uml-fields">
    @foreach (var field in Task.Fields)
    {
        <label>@field.Label
        @if (field.Kind == "Select") { <select value="@Answer.Values.GetValueOrDefault(field.Key, "")" @onchange='args => ValueAsync(field, args.Value?.ToString() ?? "")'><option value="">Bitte wählen</option>@foreach (var option in field.Options) { <option value="@option.Key">@option.Value</option> }</select> }
        else { <input maxlength="500" inputmode="@(field.Kind == "Number" ? "decimal" : "text")" value="@Answer.Values.GetValueOrDefault(field.Key, "")" @oninput='args => ValueAsync(field, args.Value?.ToString() ?? "")' /> }
        @if (field.Help.Length > 0) { <small>@field.Help</small> }
        </label>
    }
    </div>
    @if (Task.PayloadFormat != "None") { <label class="software-payload-label">Deine @(Task.PayloadFormat == "Json" ? "JSON" : "XML")-Nachricht<textarea class="software-payload" rows="10" maxlength="8000" spellcheck="false" value="@Answer.Payload" @oninput='args => PayloadAsync(args.Value?.ToString() ?? "")'>@Answer.Payload</textarea></label> }
    </fieldset>
}
<details class="software-reflection"><summary>Deine eigene Begründung ergänzen</summary><label>Freiwillige Begründung zur Selbstkontrolle<textarea rows="4" maxlength="4000" disabled="@ReadOnly" value="@Answer.Reasoning" @oninput='args => ReasoningAsync(args.Value?.ToString() ?? "")'>@Answer.Reasoning</textarea></label><p>Dieser Text bleibt mit deinem Entwurf gespeichert. Die automatische Bewertung erfasst die fachlichen Antwortfelder und Entwürfe; deine Formulierung prüfst du zusätzlich anhand der Kriterienliste.</p></details>
@code {
    /// <summary> Strukturierter Fachauftrag ohne vorweggenommene Antworten. </summary>
    [Parameter, EditorRequired] public SoftwareAssignment Task { get; set; } = new();
    /// <summary> Eigener, getrennt gespeicherter Arbeitsentwurf. </summary>
    [Parameter, EditorRequired] public SoftwareAnswer Answer { get; set; } = new();
    /// <summary> Übergibt jede Eingabe an den revisionsgeschützten Speicherablauf. </summary>
    [Parameter] public EventCallback Changed { get; set; }
    /// <summary> Verhindert Änderungen auch in allen Befehls- und Eingabehandlern. </summary>
    [Parameter] public bool ReadOnly { get; set; }
    private readonly string _group = "software-choice-" + Guid.NewGuid().ToString("N");
    private System.Threading.Tasks.Task ChangedAsync() => ReadOnly ? System.Threading.Tasks.Task.CompletedTask : Changed.InvokeAsync();
    private async System.Threading.Tasks.Task SelectAsync(string id) { if (ReadOnly || !Task.Options.ContainsKey(id)) return; if (Task.CorrectIds.Count == 1) Answer.SelectedIds = [id]; else if (!Answer.SelectedIds.Remove(id)) Answer.SelectedIds.Add(id); await ChangedAsync(); }
    private async System.Threading.Tasks.Task ValueAsync(SoftwareField field, string value) { if (ReadOnly || value.Length > 500 || !Task.Fields.Contains(field) || field.Kind == "Select" && value.Length > 0 && !field.Options.ContainsKey(value)) return; Answer.Values[field.Key] = value; await ChangedAsync(); }
    private async System.Threading.Tasks.Task PayloadAsync(string value) { if (ReadOnly || value.Length > 8000) return; Answer.Payload = value; await ChangedAsync(); }
    private async System.Threading.Tasks.Task ReasoningAsync(string value) { if (ReadOnly || value.Length > 4000) return; Answer.Reasoning = value; await ChangedAsync(); }
    private async System.Threading.Tasks.Task AddNodeAsync() { if (ReadOnly || Answer.Board.Nodes.Count >= 16) return; Answer.Board.Nodes.Add(new() { Kind = Task.NodeKinds.Keys.First() }); await ChangedAsync(); }
    private async System.Threading.Tasks.Task RemoveNodeAsync(SoftwareNode node) { if (ReadOnly) return; Answer.Board.Nodes.Remove(node); Answer.Board.Links.RemoveAll(link => link.Source == node.Id || link.Target == node.Id); await ChangedAsync(); }
    private async System.Threading.Tasks.Task NodeAsync(SoftwareNode node, string property, string value)
    {
        if (ReadOnly || !Answer.Board.Nodes.Contains(node) || value.Length > (property == "Hint" ? 200 : 80)) return;
        switch (property)
        {
            case "Key" when value.Length == 0 || Task.NodeVocabulary.ContainsKey(value): node.Key = value; node.Name = Task.NodeVocabulary.GetValueOrDefault(value, ""); break;
            case "Kind" when Task.NodeKinds.ContainsKey(value): node.Kind = value; break;
            case "Group" when value.Length == 0 || Task.Groups.ContainsKey(value): node.Group = value; break;
            case "Name": node.Name = value; break;
            case "Hint": node.Hint = value; break;
            default: return;
        }
        await ChangedAsync();
    }
    private async System.Threading.Tasks.Task RequiredAsync(SoftwareNode node, bool value) { if (ReadOnly || !Answer.Board.Nodes.Contains(node)) return; node.Required = value; await ChangedAsync(); }
    private async System.Threading.Tasks.Task MoveAsync(SoftwareNode node, int direction) { if (ReadOnly || direction is not (-1 or 1)) return; int index = Answer.Board.Nodes.IndexOf(node), next = index + direction; if (index < 0 || next < 0 || next >= Answer.Board.Nodes.Count) return; (Answer.Board.Nodes[index], Answer.Board.Nodes[next]) = (Answer.Board.Nodes[next], Answer.Board.Nodes[index]); await ChangedAsync(); }
    private async System.Threading.Tasks.Task AddLinkAsync() { if (ReadOnly || Answer.Board.Nodes.Count == 0 || Answer.Board.Links.Count >= 32 || Task.LinkKinds.Count == 0) return; Answer.Board.Links.Add(new() { Kind = Task.LinkKinds.Keys.First() }); await ChangedAsync(); }
    private async System.Threading.Tasks.Task RemoveLinkAsync(SoftwareLink link) { if (ReadOnly) return; Answer.Board.Links.Remove(link); await ChangedAsync(); }
    private async System.Threading.Tasks.Task LinkAsync(SoftwareLink link, string property, string value)
    {
        if (ReadOnly || !Answer.Board.Links.Contains(link)) return;
        if (property == "Source" && (value.Length == 0 || Answer.Board.Nodes.Any(node => node.Id == value))) link.Source = value;
        else if (property == "Target" && (value.Length == 0 || Answer.Board.Nodes.Any(node => node.Id == value))) link.Target = value;
        else if (property == "Kind" && Task.LinkKinds.ContainsKey(value)) link.Kind = value;
        else return;
        await ChangedAsync();
    }
}
