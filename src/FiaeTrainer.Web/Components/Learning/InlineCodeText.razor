@{
    string[] parts = Text.Split('`');
}
@if (parts.Length % 2 == 0)
{
    @Text
}
else
{
    @for (int i = 0; i < parts.Length; i++)
    {
        if (i % 2 == 0)
        {
            @parts[i]
        }
        else
        {
            <code>@parts[i]</code>
        }
    }
}

@code {
    /// <summary> Aufgabentext mit ausdrücklich durch Backticks markierten Codefragmenten. </summary>
    [Parameter, EditorRequired] public string Text { get; set; } = "";
}
