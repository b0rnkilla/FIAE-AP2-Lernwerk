@page "/softwareplanung/spickzettel"
@inject ProgressStore Store
@inject SoftwareCatalog Catalog
<PageTitle>Entwurfs-Spickzettel · AP2 Lernwerk</PageTitle>
<main class="page reading-page">
    <div class="eyebrow">VOM KUNDENWUNSCH ZUM SOFTWAREENTWURF</div>
    <h1>Dein Entwurfs-Spickzettel.</h1>
    <a class="button secondary" href="@ReturnPath">Zurück zu deiner Aufgabe →</a>
    @if (_notice != null) { <p class="notice" role="status">@_notice</p> }
    <section class="reference-section"><h2>Anforderungen überprüfbar festhalten</h2><p>Funktionale Anforderungen beschreiben, was die Anwendung leisten soll. Nichtfunktionale Anforderungen beschreiben unter anderem Qualitätsziele und Randbedingungen. „Schnell“ braucht beispielsweise einen Messgegenstand, eine Zeitgrenze und eine definierte Nutzungssituation. Eine User Story verbindet Rolle, gewünschte Funktion und fachlichen Nutzen. Akzeptanzkriterien machen erwartetes Verhalten beobachtbar, einschließlich relevanter Grenzen.</p><p>In den Aufgaben beschreibt das Lastenheft den Bedarf aus Auftraggebersicht, das Pflichtenheft die vereinbarte Umsetzung durch den Auftragnehmer. Vereinbarter Umfang, spätere Wünsche und offene Fragen bleiben erkennbar getrennt.</p></section>
    <section class="reference-section"><h2>Objekte, Zustand und Kapselung</h2><p>Eine Klasse beschreibt einen Bauplan. Verschiedene Objekte derselben Klasse besitzen ihre eigene Identität und ihren Instanzzustand. Ein Konstruktor initialisiert ein neues Objekt. Statische Merkmale gehören dagegen zum gemeinsamen Klassenbereich. Kontrollierte öffentliche Operationen können Vorbedingungen prüfen und privaten Zustand schützen. Wird eine Änderung abgelehnt, muss der vereinbarte alte Zustand erhalten bleiben.</p><p>Die Codeunterlagen verwenden jeweils die ausdrücklich erklärte sprachneutrale Notation. Sie trainieren Aufrufziele, Zustandsänderungen und Rückgaben. Ein erfolgreicher Build allein beweist keine richtige Fachlogik.</p></section>
    <section class="reference-section"><h2>Gemeinsamer Vertrag, verschiedene Implementierungen</h2><p>Ein Interface beschreibt hier angebotene Operationen, ohne identische private Felder vorzuschreiben. Eine abstrakte Basisklasse kann darüber hinaus gemeinsame Implementierung und Zustand beitragen. Polymorphie erlaubt denselben Aufruf über einen gemeinsamen Vertrag; bei dynamischer Auswahl zählt die tatsächliche konkrete Objektart.</p><p>Überladen verwendet unterschiedliche Parameterlisten. Überschreiben ersetzt die dafür vorgesehene geerbte Implementierung. Ein anderer Rückgabetyp allein bildet in der verwendeten Notation keine Überladung. Bei der Zusammensetzung verwendet ein Objekt einen Partner über dessen Vertrag. Vererbung beschreibt dagegen eine Spezialisierung. Der konkrete Auftrag entscheidet, welche Beziehung gemeint ist.</p></section>
    <section class="reference-section"><h2>Entwurfsmuster nach ihrer Absicht auswählen</h2><dl class="software-answer-list"><dt>Observer</dt><dd>Registrierte Beobachter über Zustandsänderungen informieren.</dd><dt>Strategy</dt><dd>Austauschbares Verhalten hinter einem gemeinsamen Vertrag verwenden.</dd><dt>Factory Method</dt><dd>Eine überschreibbare Erzeugeroperation konkrete Produkte liefern lassen.</dd><dt>Adapter</dt><dd>Eine vorhandene fremde Schnittstelle an einen benötigten Vertrag anpassen.</dd><dt>Singleton</dt><dd>Eine Instanz mit globalem Zugriff adressieren; gemeinsamen veränderlichen Zustand und versteckte Abhängigkeiten kritisch prüfen.</dd></dl><p>Eine statische Fabrik mit Typauswahl ist nicht allein aufgrund ihres Namens die GoF Factory Method. Zusätzliche Klassen und Muster benötigen einen konkreten Anlass. In den Diagrammaufgaben werden ausdrücklich genannte Strukturausschnitte geprüft; das Verhalten eines beliebigen Methodenrumpfs wird daraus nicht automatisch bewiesen.</p></section>
    <section class="reference-section"><h2>Architektur und Abhängigkeiten</h2><p>Eine vereinbarte Schichtenaufteilung kann Darstellung, Fachlogik und Datenzugriff trennen. Zusammengehörige Verantwortung unterstützt verständliche Bausteine; unnötige Kopplung erschwert Änderungen. Ein fachlicher Dienst kann gegen einen Vertrag arbeiten, den die technische Speicherung implementiert. Die Entwurfsabhängigkeit auf einen Vertrag und die spätere Laufzeitaufrufrichtung sind unterschiedliche Betrachtungen.</p><p>MVC unterscheidet fachlichen Zustand im Model, Darstellung in der View und Eingabekoordination im Controller. Die Aufgaben benennen jeweils die konkret gewählte Variante. Nicht jede zulässige MVC-Umsetzung besitzt genau dieselben Pfeile. Eine Browser-/Servergrenze zeigt logische Zugriffe und ersetzt keine vollständige Sicherheitsbewertung.</p></section>
    <section class="reference-section"><h2>HTTP und Nachrichtenverträge</h2><p>Ein Schnittstellenvertrag benennt Operation, Ressourcenpfad, benötigte Daten und Ergebnis. GET ruft eine Darstellung ab, POST verarbeitet eine Anfrage gemäß Ressourcenvertrag, PUT ersetzt die Darstellung am adressierten Ziel und PATCH beschreibt eine partielle Änderung. DELETE fordert das Entfernen der Zuordnung am Ziel an. Die konkrete API-Vereinbarung legt die zulässigen Daten und erwarteten Antworten fest.</p><p>2xx kennzeichnet erfolgreiche Verarbeitung, 4xx einen Fehler im Bereich der Anfrage und 5xx einen serverseitigen Fehler. 201 kann eine neu angelegte Ressource, 404 eine nicht gefundene Ressource anzeigen. 200 und 204 haben unterschiedliche Rückgabesemantik; die Aufgaben sagen ausdrücklich, welcher Antwortvertrag gilt.</p><p>JSON unterscheidet Objekte, Arrays, Zahlen, Zeichenfolgen, Wahrheitswerte und null. Eigenschaftsreihenfolge ist in den Aufgaben frei, die verlangte Arrayreihenfolge zählt. Doppelte Eigenschaftsnamen werden nicht als verlässlicher Vertrag akzeptiert. Bei XML zählen Elementnamen, Hierarchie, Attribute, Reihenfolge und Textwerte. Einrückung, Kommentare und eine erlaubte Deklaration ersetzen keine Nutzdaten. Externe Entitäten gehören nicht zu den Lernnachrichten.</p></section>
    <section class="reference-section"><h2>Oberflächen verständlich konzipieren</h2><p>Wähle Eingabeelemente nach der benötigten Angabe. Sichtbare Beschriftungen bleiben auch nach Eingaben erkennbar. Zusammengehörige Angaben erhalten sinnvolle Gruppen. Pflichtfelder, Hilfetexte, nachvollziehbare Reihenfolge und konkrete Fehlerhinweise unterstützen die Bedienung. Farbe allein erklärt einen Fehler nicht; gültige Eingaben sollen bei Rückfragen erhalten bleiben.</p><p>Der Formularbaukasten zeigt deine tatsächlich gewählten Feldarten und Gruppen in einer Vorschau. Früher/Später legt deren Reihenfolge fest. Die Vorschau prüft einfache Pflichtangaben, aber keine vollständige Termin- oder Bestandslogik. Deine eigenen Beschriftungen und Hilfetexte besprichst du zusätzlich anhand der Kriterienliste. Ein Prototyp soll eine bestimmte offene Frage beantworten; er ist nicht automatisch die fertige Anwendung.</p></section>
    <section class="reference-section"><h2>Werkzeuge, Wiederverwendung und Übergabe</h2><p>Eine IDE kann Editor, Navigation, Build und Debugger bündeln. Ein Compiler übersetzt Quellcode in eine andere Darstellung; reale Systeme können Interpretation und weitere Übersetzung kombinieren. Der Debugger zeigt einen angehaltenen Ablauf, API-Dokumentation erklärt Verträge, Versionsverwaltung macht Änderungen nachvollziehbar, ein Formatter vereinheitlicht die Darstellung.</p><p>Bei einer Bibliothek ruft die Anwendung benötigte Funktionen auf. Ein Framework kann Ablauf und Erweiterungspunkte vorgeben und Anwendungscode aufrufen. Prüfe den konkreten Funktionsbedarf, Kompatibilität, Pflege und die im Projekt geklärten Nutzungsvorgaben. Commits und Review unterstützen Zusammenarbeit; ein Merge-Konflikt braucht eine fachliche Entscheidung. Zur Übergabe gehören Zweck, Parameter, Rückgaben, Fehlerfälle, Konfiguration ohne Geheimnisse und nachvollziehbare Entwurfsentscheidungen.</p></section>
    <section class="reference-section"><h2>Bewertung, Begründung und Prüfung</h2><p>48 Lernaufgaben in acht Kapiteln bieten Auswahl, Ausarbeitung, Reparatur und eigene Klassen-, Architektur-, Nachrichten- und Formularentwürfe. Die automatische Bewertung prüft feste Fachrollen und ausdrücklich beschriebene Varianten. Anzeigenamen und Parameternamen sind frei, vorgegebene Vertragsnamen und Nachrichtenwerte dagegen verbindlich. Freie Begründungen sind ein gespeicherter Zusatz zur Selbstkontrolle und verändern die automatische Bewertung nicht.</p><p>Drei eigene Trainingsfälle verwenden je drei unabhängige Teilaufträge, 45 Minuten und 50 Trainingspunkte. Dies sind modulbezogene Trainingsrunden; der offizielle schriftliche Prüfungsbereich Planen eines Softwareproduktes dauert 90 Minuten. Start erst nach Aktion; UTC-Uhr läuft beim Browserende weiter. Pause blendet Entwürfe aus, Nachschlagen pausiert und kennzeichnet Unterstützung. Eine endgültige Abgabe ist gesperrt. Die Bewertung ist keine amtliche IHK-Note und behauptet keine vollständige Katalogabdeckung.</p></section>
    <section class="reference-section"><h2>Fachliche Grundlagen</h2><p><a href="https://www.gesetze-im-internet.de/fiausbv/__13.html" target="_blank" rel="noopener noreferrer">Ausbildungsordnung: Planen eines Softwareproduktes</a> · <a href="https://learn.microsoft.com/en-us/dotnet/architecture/modern-web-apps-azure/architectural-principles" target="_blank" rel="noopener noreferrer">Microsoft: Architekturprinzipien</a> · <a href="https://www.rfc-editor.org/rfc/rfc9110.html" target="_blank" rel="noopener noreferrer">IETF: HTTP-Semantik</a> · <a href="https://www.w3.org/WAI/tutorials/forms/" target="_blank" rel="noopener noreferrer">W3C: Zugängliche Formulare</a>. Die Fälle und Unterlagen sind eigene Inhalte, keine eingebetteten Originalprüfungen.</p></section>
</main>

@code {
    /// <summary> Nur eine lokale Aufgabennummer oder der feste Prüfungsrückweg ist erlaubt. </summary>
    [SupplyParameterFromQuery(Name = "aufgabe")] public int? LessonId { get; set; }
    [SupplyParameterFromQuery(Name = "pruefung")] public bool Exam { get; set; }
    private string ReturnPath = "/softwareplanung/1";
    private string? _notice;
    protected override async Task OnInitializedAsync()
    {
        if (Exam) ReturnPath = "/softwareplanung/pruefung/runde";
        else if (LessonId is { } requested && Catalog.Lessons.Any(task => task.Id == requested)) ReturnPath = "/softwareplanung/" + LessonId.Value;
        try
        {
            var state = await Store.LoadAsync();
            if (Exam)
            {
                ReturnPath = "/softwareplanung/pruefung/runde";
                if (state.SoftwareExam is { FinishedUtc: null } round)
                {
                    if (round.SecondsLeft(DateTimeOffset.UtcNow) > 0) { round.Pause(DateTimeOffset.UtcNow); round.UsedReference = true; }
                    var saved = await Store.SaveSoftwareExamAsync(round, Catalog);
                    _notice = saved.FinishedUtc != null ? "Die Prüfungszeit ist abgelaufen. Deine letzte gespeicherte Abgabe wurde ausgewertet." : "Die Prüfung pausiert und wird als mit Nachschlagen gekennzeichnet.";
                }
            }
            else
            {
                int id = LessonId is { } selected && Catalog.Lessons.Any(task => task.Id == selected) ? selected : state.LastSoftwareLessonId;
                var task = Catalog.Lessons.SingleOrDefault(task => task.Id == id) ?? Catalog.Lessons[0];
                ReturnPath = "/softwareplanung/" + task.Id;
                var progress = state.SoftwareLessons.GetValueOrDefault(task.Id) ?? new() { Answer = task.InitialAnswer() }; progress.Assisted = true;
                await Store.SaveSoftwareAsync(task.Id, progress, Catalog);
            }
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or UnauthorizedAccessException or System.Text.Json.JsonException) { _notice = "Der Unterstützungsstatus konnte nicht gespeichert werden. Dein Entwurf wird nicht überschrieben."; }
    }
}
