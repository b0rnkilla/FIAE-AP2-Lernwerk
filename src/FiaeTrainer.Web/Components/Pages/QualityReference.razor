@page "/qualitaet/spickzettel"
@inject ProgressStore Store
@inject QualityCatalog Catalog
<PageTitle>Qualitäts-Spickzettel · AP2 Lernwerk</PageTitle>
<main class="page reading-page">
    <div class="eyebrow">VOM SOFTWAREENTWURF ZUM PROBEBETRIEB</div><h1>Dein Qualitäts-Spickzettel.</h1><a class="button secondary" href="@ReturnPath">Zurück zu deiner Aufgabe →</a>
    @if (_notice != null) { <p class="notice" role="status">@_notice</p> }
    <section class="reference-section"><h2>Qualitätsziele und statische Prüfung</h2><p>Qualität umfasst unter anderem funktionale Eignung, Effizienz, Sicherheit und Wartbarkeit. Das Produktqualitätsmodell ISO/IEC 25010:2023 unterscheidet neun Merkmale; ältere Fassungen verwenden andere Einteilungen. Die Aufgaben nennen die jeweils benötigte Eigenschaft und verlangen keine vollständige Normwiedergabe.</p><p>Ein überprüfbares Ziel benennt Messgegenstand, Grenze, Umgebung und Nutzungssituation. Statische Prüfungen untersuchen Unterlagen oder Code ohne Programmausführung: etwa Reviews und statische Analyse. Dynamische Tests führen das Testobjekt aus. Ein Reviewbefund beschreibt die konkrete widersprüchliche oder fehlende Angabe.</p></section>
    <section class="reference-section"><h2>Teststufen, Testarten und Prioritäten</h2><p>Komponententests prüfen einzelne Bausteine, Integrationstests das Zusammenspiel, Systemtests das Gesamtsystem und Abnahmetests die vereinbarten Bedürfnisse. Funktionale Tests prüfen das Was, nichtfunktionale Tests beispielsweise Lastverhalten. Eine Testart ist keine Teststufe. Priorisiere nach ausdrücklich gegebenem Risiko aus Eintritt und Auswirkung.</p><p>Ein Stub liefert kontrollierte Antworten. Ein Mock kann zusätzlich erwartete Aufrufe überprüfen. Welches Testdouble nötig ist, entscheidet der Testzweck. Ein bestandener isolierter Test beweist nicht automatisch die richtige Zusammenarbeit mit der echten Datenbank oder einem externen Dienst.</p></section>
    <section class="reference-section"><h2>Blackbox: eigene Testfälle ableiten</h2><p>Leite Sollwerte aus der Spezifikation ab. Äquivalenzklassen gruppieren Eingaben mit vergleichbarem Verhalten; gültige und ungültige Klassen gehören dazu. Grenzwerttests betrachten ausdrücklich vereinbarte Grenzen und ihre Nachbarn. Eine Entscheidungstabelle ordnet Bedingungskombinationen den Aktionen zu. Zustandsbasierte Tests berücksichtigen Ausgangszustand, Ereignis und erlaubten Übergang.</p><p>Du legst Eingaben und erwartetes Ergebnis selbst fest. Andere geeignete Vertreter als in der Musterlösung sind erlaubt. Jeder Tabellenfall besitzt seinen eigenen Ausgangszustand. Ein vorheriger Fall verändert keinen späteren. Der Testdatenbereich beschreibt die zulässige Eingabe in der Werkstatt; darin können fachlich ungültige Werte zum Prüfen einer Ablehnung liegen.</p></section>
    <section class="reference-section"><h2>Whitebox: was wurde ausgeführt?</h2><p>Anweisungsüberdeckung = ausgeführte gezählte Anweisungen / alle gezählten Anweisungen. Zweigüberdeckung = ausgeführte gezählte Zweige / alle gezählten Zweige. 100 % Anweisungsüberdeckung bedeuten nicht automatisch 100 % Zweigüberdeckung. Auch vollständige Zweigüberdeckung beweist keine Fehlerfreiheit und keine vollständige Pfadüberdeckung.</p><p>In dieser Werkstatt markieren S1, S2 usw. ausdrücklich die gezählten ausführbaren Anweisungen. D1.T und D1.F markieren den Wahr- beziehungsweise Falsch-Ausgang einer Entscheidung. Der angezeigte Zweigwert bezieht sich auf diese bedingten Ausgänge, nicht auf jede denkbare formale Kontrollflusskante. Pfade sind hier die erreichbaren vollständigen Folgen der D-Ausgänge in kleinen schleifenfreien Modellen. Kurzschluss-Teilausdrücke werden nicht als eigene Entscheidungen gezählt.</p><p>Eine ausgeführte Zeile zählt zur Abdeckung auch bei einem falschen Sollwert. Als Fehlernachweis zählt ein Test erst, wenn sein Sollwert zum Fachvertrag passt und eine angebotene Fehlervariante davon abweicht. Eine bewusst fehlerhafte Variante kann bei einzelnen Eingaben zufällig das richtige Ergebnis liefern. Weitere passende Vertreter können nötig sein. Es handelt sich um acht feste lokale Modelle, keinen allgemeinen Codeausführer oder Beweis aller möglichen Fehler.</p></section>
    <section class="reference-section"><h2>Unit-Tests verständlich und stabil schreiben</h2><p>Arrange richtet Ausgangslage und kontrollierte Abhängigkeiten ein. Act führt die untersuchte Aktion aus. Assert vergleicht die beobachtete Wirkung mit einem unabhängig begründeten Sollwert. Ein Vergleich eines Ergebnisses mit sich selbst prüft den Fachvertrag nicht.</p><p>Jeder Test erhält seinen eigenen Zustand. Kontrolliere Uhrzeit, Zufall und fremde Dienste, wenn diese das Ergebnis beeinflussen. Identische Testdaten bedeuten allein keine Isolation, wenn die Tests denselben veränderlichen Speicher teilen. Aussagekräftige Tests prüfen richtige Ausgaben, relevante Grenzen und Fehlerfälle.</p></section>
    <section class="reference-section"><h2>Fehlerbericht und Freigabe</h2><p>Ein nachvollziehbarer Fehlerbericht enthält Stand und Umgebung, Ausgangslage, reproduzierbare Schritte, erwartetes und tatsächliches Ergebnis sowie geeignete Nachweise. Schweregrad beschreibt die Auswirkung; Priorität die vereinbarte Bearbeitungsdringlichkeit. Fehlende Informationen sind keine Grundlage für erfundene Prioritäten.</p><p>Nachtest prüft die konkrete Korrektur, Regressionstests prüfen mögliche Nebenwirkungen. Eine Prüfkette kann Build, Tests und Sicherheitsprüfungen als Freigabebedingungen verbinden. Ein erfolgreicher Build ersetzt keine bestandenen Tests. Ungeprüfte Wiederherstellung und offene kritische Zugriffsfehler gelten nicht als bestandene Nachweise.</p></section>
    <section class="reference-section"><h2>Schutzziele, Rollen und Daten</h2><p>Vertraulichkeit schützt vor unberechtigtem Lesen, Integrität vor unberechtigter Veränderung und Verfügbarkeit die erforderliche Nutzbarkeit. Authentifizierung prüft Identität, Autorisierung die erlaubte Aktion am konkreten Objekt. Eine Anmeldung allein erlaubt keinen Zugriff auf fremde Vorgänge. Rechte gehören serverseitig bei jeder relevanten Aktion geprüft; versteckte Schaltflächen ersetzen das nicht.</p><p>Eine Rechte-Matrix macht Rolle, Aktion und Objektbezug ausdrücklich. Nach dem Prinzip geringster Rechte erhalten Rollen nur benötigte Freigaben. Erhebe für den beschriebenen Zweck benötigte Daten. Passwörter, Tokens und unnötige personenbezogene Inhalte gehören nicht in Diagnoseprotokolle. Die Fälle behandeln technische Entscheidungen anhand vorgegebener Zwecke, keine vollständige rechtliche Prüfung.</p></section>
    <section class="reference-section"><h2>Eingaben, Ausgaben und Sitzungen absichern</h2><p>Bei SQL-Injection werden Daten und SQL-Struktur vermischt. Parameter schützen Datenwerte; dynamische Bezeichner wie Sortierspalten brauchen eine feste erlaubte Auswahl. Minimale Datenbankrechte begrenzen Auswirkungen. Für XSS zählt die zum Ausgabekontext passende sichere Verarbeitung. Bei reinem Text ist eine Textausgabe statt ungeprüftem HTML sinnvoll. Kontextabhängige Kodierung ersetzt keine Berechtigungsprüfung.</p><p>CSRF betrifft unerwünschte Aktionen mit automatisch mitgesendeter Sitzungsberechtigung. Zustandsänderungen gehören nicht in GET-Aufrufe. Serverseitig geprüfte Schutzmechanismen wie geeignete Anti-CSRF-Tokens ergänzen Sitzungs- und Berechtigungsprüfung. HTTPS allein verhindert CSRF nicht. Eingaben müssen unabhängig von Browserprüfungen serverseitig validiert werden.</p><p>Die Unterlagen sind lokale Reviewbeispiele. Es werden keine Angriffe gegen Datenbanken, Webseiten oder Netzwerke ausgeführt. Bei einem beschriebenen Geheimnisverlust folgen Eindämmung, Widerruf, Behebung und Prüfung dem jeweils ausdrücklich vorgegebenen Ablauf.</p></section>
    <section class="reference-section"><h2>Kryptografie und Wiederherstellung</h2><p>Verschlüsselung schützt Vertraulichkeit. Ein Hash unterstützt einen Integritätsvergleich, wenn der Vergleichswert aus einer vertrauenswürdigen Quelle stammt; er verschlüsselt keine Nachricht und beweist allein keinen Urheber. Signaturen werden mit dem öffentlichen Schlüssel des Absenders geprüft. Ein vereinfachtes hybrides Verfahren kombiniert symmetrische Nutzdatenverschlüsselung mit asymmetrischem Schutz des Sitzungsschlüssels. Der Übungsablauf ist kein vollständiger TLS-Handshake.</p><p>Passwörter brauchen geeignete langsame, gesalzene Passwort-Hashverfahren wie Argon2id. Ein schneller SHA-256-Hash allein ist dafür ungeeignet. Ein individueller Salt ist kein geheimes Passwort und kann beim Hash gespeichert werden. TLS-Zertifikatsprüfung berücksichtigt unter anderem Vertrauenskette, Gültigkeit und passenden Hostnamen.</p><p>Eine Sicherung ist erst mit geprüftem Wiederherstellungsweg belastbar. Inkrementelle Sicherungen hängen vom ausdrücklich beschriebenen früheren Stand ab. Vollsicherung und alle benötigten Inkremente werden in ihrer Abhängigkeit wiederhergestellt, anschließend wird das Ergebnis geprüft. Verschlüsselung ersetzt weder Sicherung noch Restoretest.</p></section>
    <section class="reference-section"><h2>Deine Bewertung und Trainingsprüfung</h2><p>54 eigene Lernaufgaben in neun Kapiteln verwenden feste Fachverträge. Die Lernansicht zeigt fachliche Rückmeldung ohne Trainingspunkte.</p><p>Drei eigene Prüfungsfälle bieten je drei unabhängige Teile, 45 Minuten und 50 Trainingspunkte. Dies sind modulbezogene Trainingsrunden. Die offiziellen schriftlichen Prüfungsbereiche nach §§ 13 und 14 der Ausbildungsordnung dauern jeweils 90 Minuten. Die Uhr beginnt erst mit deiner Aktion, läuft beim Browserende weiter und lässt sich mit ausgeblendeten Aufgaben pausieren. Nachschlagen pausiert und kennzeichnet Unterstützung. Ergebnisse erscheinen nach endgültiger Abgabe; eine amtliche IHK-Note oder vollständige Prüfungsabdeckung wird nicht behauptet.</p></section>
    <section class="reference-section"><h2>Fachliche Grundlagen · geprüft am 11.11.2026</h2><p><a href="https://www.gesetze-im-internet.de/fiausbv/__13.html" target="_blank" rel="noopener noreferrer">Ausbildungsordnung § 13</a> · <a href="https://www.gesetze-im-internet.de/fiausbv/__14.html" target="_blank" rel="noopener noreferrer">Ausbildungsordnung § 14</a> · <a href="https://istqb.org/certifications/certified-tester-foundation-level-ctfl-v4-0/" target="_blank" rel="noopener noreferrer">ISTQB CTFL 4.0</a> · <a href="https://committee.iso.org/cms/live/live/en/sites/isoorg/contents/data/standard/07/81/78176.html" target="_blank" rel="noopener noreferrer">ISO/IEC 25010:2023</a> · <a href="https://cheatsheetseries.owasp.org/cheatsheets/Authorization_Cheat_Sheet.html" target="_blank" rel="noopener noreferrer">OWASP: Autorisierung</a> · <a href="https://cheatsheetseries.owasp.org/cheatsheets/SQL_Injection_Prevention_Cheat_Sheet.html" target="_blank" rel="noopener noreferrer">OWASP: SQL-Injection</a> · <a href="https://cheatsheetseries.owasp.org/cheatsheets/Cross_Site_Scripting_Prevention_Cheat_Sheet.html" target="_blank" rel="noopener noreferrer">OWASP: XSS-Prävention</a> · <a href="https://cheatsheetseries.owasp.org/cheatsheets/Password_Storage_Cheat_Sheet.html" target="_blank" rel="noopener noreferrer">OWASP: Passwortspeicherung</a>. Alle Fälle und Unterlagen sind eigene Inhalte; Originalprüfungen werden nicht mitgeliefert.</p></section>
</main>

@code {
    /// <summary> Nur eine lokale Aufgabennummer oder der feste Prüfungsrückweg ist erlaubt. </summary>
    [SupplyParameterFromQuery(Name = "aufgabe")] public int? LessonId { get; set; }
    [SupplyParameterFromQuery(Name = "pruefung")] public bool Exam { get; set; }
    private string ReturnPath = "/qualitaet/1";
    private string? _notice;
    protected override async Task OnInitializedAsync()
    {
        if (Exam) ReturnPath = "/qualitaet/pruefung/runde";
        else if (LessonId is { } requested && Catalog.Lessons.Any(task => task.Id == requested)) ReturnPath = "/qualitaet/" + LessonId.Value;
        try
        {
            var state = await Store.LoadAsync();
            if (Exam)
            {
                ReturnPath = "/qualitaet/pruefung/runde";
                if (state.QualityExam is { FinishedUtc: null } round)
                {
                    if (round.SecondsLeft(DateTimeOffset.UtcNow) > 0) { round.Pause(DateTimeOffset.UtcNow); round.UsedReference = true; }
                    var saved = await Store.SaveQualityExamAsync(round, Catalog);
                    _notice = saved.FinishedUtc != null ? "Die Prüfungszeit ist abgelaufen. Deine letzte gespeicherte Abgabe wurde ausgewertet." : "Die Prüfung pausiert und wird als mit Nachschlagen gekennzeichnet.";
                }
            }
            else
            {
                int id = LessonId is { } selected && Catalog.Lessons.Any(task => task.Id == selected) ? selected : state.LastQualityLessonId;
                var task = Catalog.Lessons.SingleOrDefault(task => task.Id == id) ?? Catalog.Lessons[0];
                ReturnPath = "/qualitaet/" + task.Id;
                var progress = state.QualityLessons.GetValueOrDefault(task.Id) ?? new() { Answer = task.InitialAnswer() }; progress.Assisted = true;
                await Store.SaveQualityAsync(task.Id, progress, Catalog);
            }
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or UnauthorizedAccessException or System.Text.Json.JsonException) { _notice = "Der Unterstützungsstatus konnte nicht gespeichert werden. Dein Entwurf wird nicht überschrieben."; }
    }
}
