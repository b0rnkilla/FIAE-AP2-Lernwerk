@page "/datenbankentwurf/spickzettel"
@inject ProgressStore Store
@inject DesignCatalog Catalog
<PageTitle>Datenbankentwurf-Spickzettel · AP2 Lernwerk</PageTitle>
<main class="page reading-page"><div class="eyebrow">VON DER GESCHÄFTSREGEL ZUM MODELL</div><h1>Dein Datenbankentwurf-Spickzettel.</h1><a class="button secondary" href="@ReturnPath">Zurück zu deiner Aufgabe →</a>
    @if (_notice != null) { <p class="notice" role="status">@_notice</p> }
    <section class="reference-section"><h2>Entitäten, Tabellen und Attribute</h2><p>Eine Entität ist ein konkretes Objekt, beispielsweise ein bestimmter Kunde. Ein Entitätstyp beschreibt gleichartige Objekte. Im relationalen Modell entstehen Tabellen mit einzelnen Datensätzen und Attributen. Eine variable Liste von Telefonnummern wird als Menge eigener Kontaktdatensätze modelliert, wenn jede Nummer selbst verarbeitet werden soll.</p></section>
    <section class="reference-section"><h2>ER-Diagramm und relationales Modell unterscheiden</h2><p>Ein fachliches ER-Diagramm zeigt Entitätstypen als Rechtecke, Beziehungen als Rauten und Attribute als Ovale. Auch eine Beziehung kann Eigenschaften besitzen: Das Honorar einer Mitwirkung gehört zum Paar aus Referent und Programmpunkt. Technische Fremdschlüssel entstehen erst bei der Überführung in Tabellen.</p><p>In den ER-Abbildungen dieses Lernwegs zählt die Angabe an einem Linienende die Objekte dieser Seite je Objekt der Gegenseite. Steht bei Kunde 1..1 und bei Buchung 0..n, gehört jede Buchung zu genau einem Kunden; ein Kunde darf null bis viele Buchungen besitzen. Die ausgeschriebene Liste unter dem Bild nennt beide Richtungen.</p><p>Bei einer n:m-Beziehung entsteht eine Zuordnungstabelle mit beiden Referenzen und den Beziehungsattributen. Bei einer 1:n-Beziehung liegt der FK auf der n-Seite. Für eine optionale 1:1-Ergänzung muss der FK auf der abhängigen Seite eindeutig sein; eine vorhandene Ergänzung kann trotzdem eine Pflichtzuordnung haben.</p><p>Die ER-Ergänzungsaufgaben verwenden markierte Beschriftungsfelder mit angebotenen Fachbegriffen. Sie üben das Lesen und gezielte Vervollständigen einer Vorlage. Die Übersetzungsaufgaben verlangen anschließend eigene Tabellen im Baukasten.</p></section>
    <section class="reference-section"><h2>Aus Unterlagen entwerfen</h2><p>Trenne bei einem Beleg Kopf und wiederholbare Positionen. Ordne Stammdaten ihren eigenen Kennungen zu. Leite Eindeutigkeit und Abhängigkeiten aus den ausdrücklich genannten Geschäftsregeln ab; wenige unterschiedliche Beispielwerte beweisen keinen Schlüssel. Eine Halle ohne Stand oder ein Artikel ohne Ausleihe muss unabhängig gespeichert werden können, wenn der Auftrag das verlangt.</p></section>
    <section class="reference-section"><h2>PK, FK und zusätzliche Eindeutigkeit</h2><p>Ein Schlüsselkandidat identifiziert jeden Datensatz eindeutig und ist minimal. Einer wird als Primärschlüssel (PK) ausgewählt. PK-Werte dürfen nicht fehlen. Mehrere PK-Häkchen ergeben einen gemeinsamen Schlüssel, nicht mehrere unabhängige PKs.</p><p>Ein Fremdschlüssel (FK) verweist auf einen vollständigen eindeutigen Schlüssel. Bei zusammengesetzten Schlüsseln gehören alle Attributpaare zur Referenz. Eine zusätzliche künstliche ID ersetzt die geforderte fachliche Eindeutigkeit nicht.</p><p>Im Baukasten bilden Attribute mit derselben UQ-Gruppe einen gemeinsamen zusätzlichen eindeutigen Schlüssel. Verwende unterschiedliche Gruppen für voneinander unabhängige Eindeutigkeitsregeln.</p></section>
    <section class="reference-section"><h2>Kardinalitäten richtig lesen</h2><p>Frage immer in beide Richtungen: Wie viele Aufträge je Kunde? Wie viele Kunden je Auftrag? Bei Kunde → Auftrag sind 0..n Aufträge je Kunde möglich und zugleich genau 1 Kunde je Auftrag vorgeschrieben. Der FK liegt im Auftrag, also auf der n-Seite.</p><p>Eine optionale Elternzuordnung (0..1) verlangt passende NULL-Regeln am FK. Bei einer 1:1-Ergänzung muss der FK auf der abhängigen Seite eindeutig sein. n:m benötigt eine eigene Zuordnungstabelle mit beiden Referenzen. Eigenschaften der Zuordnung, etwa Menge oder Stunden, gehören dorthin.</p><p>Eine Mindestzahl von zwei Mitarbeitenden je Auftrag ist eine zusätzliche Geschäftsregel. Ein normaler FK erzwingt sie nicht allein. Das Diagramm darf sie fachlich ausweisen; bei der technischen Umsetzung braucht es weitere kontrollierte Prüfungen.</p></section>
    <section class="reference-section"><h2>Von der 1. zur 3. Normalform</h2><p><strong>1. NF:</strong> Die Felder enthalten Einzelwerte im betrachteten Wertebereich; keine veränderlichen Listen oder festen Wiederholungsgruppen.</p><p><strong>2. NF:</strong> Zusätzlich hängt jedes Nichtschlüsselattribut vollständig von jedem Schlüsselkandidaten ab. Beispiel: Bei (AuftragId, ArtikelId) als Schlüssel hängt Artikelbezeichnung nur von ArtikelId ab und gehört in Artikel.</p><p><strong>3. NF:</strong> Fachliche transitive Abhängigkeiten dürfen keine unzulässigen Nichtschlüsselabhängigkeiten hinterlassen. Für jede nichttriviale funktionale Abhängigkeit X → A muss X ein Superschlüssel sein oder A zu einem Schlüsselkandidaten gehören. Im typischen Fall ArtikelId → KategorieId → Kategoriename werden Kategorien ausgelagert.</p><p>Eine neue ID allein normalisiert keine Tabelle. Gehe von den Geschäftsregeln und allen Schlüsselkandidaten aus, nicht nur von den wenigen Beispieldatensätzen. Behaupte beispielsweise nicht ohne Vorgabe, dass jede Postleitzahl genau einen Ort bestimmt.</p></section>
    <section class="reference-section"><h2>Anomalien und historische Fakten</h2><p>Mehrfach gespeicherte Stammdaten können bei Änderungen auseinanderlaufen. Beim Löschen einer Auftragsposition darf nicht versehentlich der letzte bekannte Artikel verloren gehen. Unabhängige Stammdaten und Vorgänge erhalten deshalb passende eigene Tabellen.</p><p>Aktueller Listenpreis und vereinbarter Positionspreis sind unterschiedliche Fakten. Ein historischer Preis kann bewusst zur Position gehören. Ob eine Aufteilung sinnvoll ist, entscheidet der ausdrücklich genannte Vertrag.</p></section>
    <section class="reference-section"><h2>So arbeitet die Bewertung</h2><p>Die Fachattribute tragen eine feste Bedeutung; Tabellen- und Anzeigenamen sowie Reihenfolge sind frei. Der Prüfer vergleicht Attributgruppen, Schlüssel, NULL-Regeln, vollständige FK-Paare und Kardinalitäten mit getesteten Varianten. Er ist kein allgemeiner Beweiser für jede denkbare freie Normalisierung. Zusätzliche Tabellen oder Eindeutigkeitsregeln können den Auftrag verändern.</p><p>Die drei eigenen Prüfungsfälle haben 45 Minuten und zusammen je 50 Trainingspunkte. Die Uhr beginnt erst mit Prüfung starten; Pause blendet Aufgaben aus. Nachschlagen bleibt als Unterstützung markiert.</p></section>
    <section class="reference-section"><h2>Fachlich nachlesen</h2><p>Die folgenden Quellen öffnen externe Seiten in einem neuen Tab.</p><ul><li><a href="https://support.microsoft.com/en-au/access/database-design-basics" target="_blank" rel="noopener noreferrer">Microsoft: Grundlagen des Datenbankentwurfs und Normalisierung</a></li><li><a href="https://learn.microsoft.com/en-us/sql/relational-databases/tables/primary-and-foreign-key-constraints" target="_blank" rel="noopener noreferrer">Microsoft: Primär- und Fremdschlüssel</a></li></ul></section>
</main>
@code {
    /// <summary> Nur eine lokale Aufgabennummer oder der feste Prüfungsrückweg ist erlaubt. </summary>
    [SupplyParameterFromQuery(Name = "aufgabe")] public int? LessonId { get; set; }
    [SupplyParameterFromQuery(Name = "pruefung")] public bool Exam { get; set; }
    private string ReturnPath = "/datenbankentwurf/1";
    private string? _notice;
    protected override async Task OnInitializedAsync()
    {
        if (Exam) ReturnPath = "/datenbankentwurf/pruefung/runde";
        else if (LessonId is { } requested && Catalog.Lessons.Any(task => task.Id == requested)) ReturnPath = "/datenbankentwurf/" + LessonId.Value;
        try
        {
            var state = await Store.LoadAsync();
            if (Exam)
            {
                ReturnPath = "/datenbankentwurf/pruefung/runde";
                if (state.DesignExam is { FinishedUtc: null } round)
                {
                    if (round.SecondsLeft(DateTimeOffset.UtcNow) > 0) { round.Pause(DateTimeOffset.UtcNow); round.UsedReference = true; }
                    var saved = await Store.SaveDesignExamAsync(round, Catalog);
                    _notice = saved.FinishedUtc != null ? "Die Prüfungszeit ist abgelaufen. Deine letzte gespeicherte Abgabe wurde ausgewertet." : "Die Prüfung pausiert und wird als mit Nachschlagen gekennzeichnet.";
                }
            }
            else
            {
                int id = LessonId is { } selected && Catalog.Lessons.Any(task => task.Id == selected) ? selected : state.LastDesignLessonId;
                var task = Catalog.Lessons.SingleOrDefault(task => task.Id == id) ?? Catalog.Lessons[0];
                ReturnPath = "/datenbankentwurf/" + task.Id;
                var progress = state.DesignLessons.GetValueOrDefault(task.Id) ?? new() { Answer = task.InitialAnswer() }; progress.Assisted = true;
                await Store.SaveDesignAsync(task.Id, progress, Catalog);
            }
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or UnauthorizedAccessException or System.Text.Json.JsonException) { _notice = "Der Unterstützungsstatus konnte nicht gespeichert werden. Dein Entwurf wird nicht überschrieben."; }
    }
}
