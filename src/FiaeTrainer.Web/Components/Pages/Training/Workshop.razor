@page "/sql-werkstatt"
@page "/sql-werkstatt/{LessonId:int}"
<PageTitle>@(_lesson?.Title ?? "SQL-Werkstatt") · AP2 Lernwerk</PageTitle>
@if (_loading && _lesson == null)
{
    <main class="page loading-state" role="status"><span class="eyebrow">GLEICH GEHT’S WEITER</span><h1>Deine Aufgabe wird geladen …</h1><p>Dein Entwurf und dein Fortschritt werden vorbereitet.</p></main>
}
else if (_lesson == null)
{
    <main class="page"><h1>Aufgabe nicht gefunden</h1><a href="/sql-werkstatt/1">Zur ersten Werkstattaufgabe</a></main>
}
else
{
    <main class="workspace workshop-workspace @(_progress.TaskListCollapsed ? "rail-collapsed" : "")">
        <TaskRail Id="task-list" Collapsed="_progress.TaskListCollapsed" CollapsedChanged="SetTaskListCollapsedAsync"><div class="eyebrow">SQL-WERKSTATT</div><h2>Daten ändern.<br />Regeln verstehen.</h2><div class="rail-progress"><span>@_progress.WorkshopLessons.Values.Count(x => x.Completed) / @Catalog.Lessons.Count gelöst</span><progress value="@_progress.WorkshopLessons.Values.Count(x => x.Completed)" max="@Catalog.Lessons.Count" aria-label="Fortschritt der SQL-Werkstatt"></progress></div><nav aria-label="Werkstattaufgaben auswählen">@foreach (var chapter in Catalog.Lessons.GroupBy(x => x.Chapter)) { <div class="chapter-label">@chapter.Key</div>@foreach (WorkshopLesson lesson in chapter) { bool completed = _progress.WorkshopLessons.TryGetValue(lesson.Id, out LessonProgress? saved) && saved.Completed;<a class="mission-link @(lesson.Id == _lesson.Id ? "selected" : "")" href="@($"/sql-werkstatt/{lesson.Id}")" aria-current="@(lesson.Id == _lesson.Id ? "step" : null)"><span class="mission-index @(completed ? "done" : "")">@(completed ? "✓" : lesson.Id.ToString("D2"))</span><span>@lesson.Title</span></a> } }</nav></TaskRail>
        <div class="mission-main" aria-busy="@(_loading ? "true" : "false")" inert="@(_loading ? "" : null)">
            @* Während des Ladens bleibt dieselbe Aufgabenliste mit ihrer aktuellen Scrollposition erhalten. *@
            @if (_loading)
            {
                <p class="task-loading-note" role="status">Deine Aufgabe wird geladen …</p>
            }
            @if (_lesson != null)
            {
                <TaskNavigationPosition Path="@($"/sql-werkstatt/{_lesson.Id}")" />
                <div class="mission-topline"><span class="eyebrow">WERKSTATT @_lesson.Id.ToString("D2") / @Catalog.Lessons.Count</span><span class="badge">@_lesson.Topic</span></div><h1>@_lesson.Title</h1>
                <LearningModePicker @key="_lesson.Id" ExamMode="_examMode" Busy="_busy" HasDraft="@(!string.IsNullOrWhiteSpace(_sql))" AssistedAttempt="_current.UsedAssistance" CanReview="_current.CanReview" HasSavedSolution="@(_current.IndependentSolution != null)" ReturnToAnswer="ReturnToAnswer" ModeChanged="SetModeAsync" />
                @if (!_progress.WorkshopCopyHelpDismissed)
                {
                    <aside class="workshop-safety dismissible-note" aria-label="Hinweis zur Arbeitskopie">
                        <button type="button" class="close-note" disabled="@(_busy || _storageError != null)" aria-label="Hinweis zur Arbeitskopie ausblenden" title="Für alle Werkstattaufgaben ausblenden" @onclick="DismissWorkshopCopyHelpAsync"><span aria-hidden="true">×</span></button>
                        <strong>Deine Arbeitskopie startet jedes Mal neu.</strong> Verwende die Tabellennamen aus diesem Fall ohne Präfix. Mehrere Befehle gehören gemeinsam in ein Skript. Änderungen betreffen nur diesen Versuch.
                    </aside>
                }
                @if (_examMode) { <SelfTestHelp Hidden="_progress.SelfTestHelpDismissed" Busy="_busy" HiddenChanged="SetSelfTestHelpHiddenAsync"><strong>So funktioniert dein Selbsttest:</strong> Lies den Auftrag und die Ausgangsdaten. Schreibe dein Skript und klicke auf „Lösung prüfen“. Danach siehst du die Bewertung und den Zustand deiner Tabellen.</SelfTestHelp> }
                <section class="task-card"><div class="eyebrow">01 · AUFGABE VERSTEHEN</div>
                    @if (_lesson.Story.Length > 0 && _lesson.Scenario.Length > 0)
                    {
                        <div class="workshop-context"><strong>Ausgangslage</strong><p>@_lesson.Story</p></div>
                        <strong>Dein Auftrag</strong>
                    }
                    <p>@_lesson.Task</p>
                </section>
                <details class="workshop-detail initial-data"><summary>Ausgangsdaten ansehen</summary>@if (!Database.Ready) { <p>Verbinde zuerst den SQL Server unter <a href="/einrichtung#sql">SQL einrichten</a>.</p> } else if (_initial == null) { <p>Die Ausgangsdaten werden geladen …</p> } else { <WorkshopResults Run="_initial" /> }</details>
                @if (!Database.Ready) { <p class="notice warning">@Database.Error <a href="/einrichtung#sql">SQL-Verbindung einrichten</a></p> }
                <section class="editor-card" aria-busy="@(_busy ? "true" : "false")">
                    <div class="editor-toolbar"><label for="workshop-editor">02 · Dein SQL-Skript</label><span>T-SQL · Microsoft SQL Server</span></div>
                    <CodeEditor @ref="_editor" @key="_lesson.Id" Id="workshop-editor" @bind-Value="_sql" Blur="SaveAsync" ReadOnly="@(_busy || _current.ShowingSavedAnswer)" CodeMode="true" Placeholder="Schreibe hier deine SQL-Anweisungen …" />
                    @if (!_examMode) { <p class="code-editor-keys">Zum Ausprobieren kannst du einzelne Anweisungen markieren. Ohne Markierung läuft das ganze Skript.</p> }
                    <div class="editor-actions"><div>@if (!_examMode) { <button class="button secondary" disabled="@(_busy || !Database.Ready)" @onclick="() => RunAsync(false)" title="Führt die Markierung oder das ganze Skript aus">Skript ausprobieren</button> }<button class="button primary" disabled="@(_busy || !Database.Ready || _current.ShowingSavedAnswer || string.IsNullOrWhiteSpace(_sql))" @onclick="() => RunAsync(true)">@(_busy ? "Wird geprüft …" : "Lösung prüfen") →</button></div></div>
                </section>
                @if (_storageError != null) { <p class="notice warning" role="alert">@_storageError</p> }
                @if (_evaluation != null) { <section class="feedback @(_evaluation.Correct ? "correct" : "retry")" role="status"><strong>@(_evaluation.TechnicalFailure ? "Technische Unterbrechung" : _evaluation.Correct ? (_evaluation.Run.Selection != null ? "Dein Skript stimmt." : "Die Änderung stimmt.") : "Prüfe dein Skript noch einmal.")</strong><p>@_evaluation.Message</p>@if (_evaluation.Correct) { <p class="discovery">@_lesson.Discovery</p><AttemptOutcomeNote Reading="_current.IsReading" ExamMode="_examMode" AssistedAttempt="_current.UsedAssistance" /> }</section> }
                @if (_run != null && (_evaluation == null || _run.Error != _evaluation.Message)) { <div class="workshop-output" @ref="_output" tabindex="-1" aria-label="Ergebnis der Skriptausführung"><WorkshopOutput Run="_run" Initial="_initial" /></div> }
                @if (!_examMode)
                {
                    <section class="briefing"><h2>Das brauchst du für diese Aufgabe</h2><WorkshopExample Lesson="_lesson" /></section>
                    <section class="help-card">
                        <div class="help-row"><div><h2>Ein Denkanstoß für dein Skript</h2><p>Öffne nur so viel Hilfe, wie du gerade brauchst.</p></div><button class="button secondary" disabled="@(_busy || _current.HintLevel >= 3)" @onclick="ShowHintAsync">@(_current.HintLevel >= 3 ? "Alle Hinweise geöffnet" : $"Hinweis {_current.HintLevel + 1} von 3 öffnen")</button></div>
                        @for (int i = 0; i < _current.HintLevel; i++) { <div class="hint"><span>@(i + 1)</span><p>@_lesson.Hints[i]</p></div> }
                        <div class="help-row">
                            <div><h2>Syntax gerade nicht im Kopf?</h2><p>Im SQL-Spickzettel findest du Regeln und Beispiele.</p></div>
                            <a href="@($"/nachschlagen?zurueck=/sql-werkstatt/{_lesson.Id}{(_lesson.ExampleSql.Length > 0 ? $"#werkstatt-{_lesson.Id}" : "")}")" class="button secondary">SQL-Spickzettel öffnen</a>
                        </div>
                        <div class="help-row">
                            <div><h2>Musterlösung</h2><p>Eine aufgedeckte Lösung zählt nicht als selbstständiger Versuch.</p></div>
                            <button class="button secondary" disabled="@_busy" aria-label="@(_showSolution ? "Musterlösung ausblenden" : "Musterlösung ansehen")" aria-expanded="@(_showSolution ? "true" : "false")" aria-controls="@(_showSolution ? "workshop-solution" : null)" @onclick="ToggleSolutionAsync">@(_showSolution ? "Ausblenden" : "Ansehen")</button>
                        </div>
                        @if (_showSolution) { <div id="workshop-solution" class="solution"><pre><code>@_lesson.ReferenceSql</code></pre><p>@_lesson.Explanation</p></div> }
                    </section>
                }
                <div class="mission-bottom">@if (_lesson.Id > 1) { <a class="button secondary" href="@($"/sql-werkstatt/{_lesson.Id - 1}")">← Vorherige Aufgabe</a> }<span></span>@if (_lesson.Id < Catalog.Lessons.Count) { <a class="button primary" href="@($"/sql-werkstatt/{_lesson.Id + 1}")">Nächste Aufgabe →</a> } else { <a class="button primary" href="/lernplan">Zur Wiederholung →</a> }</div>
            }
        </div>
        @if (_lesson is { Scenario.Length: > 0 })
        {
            <aside class="inspector workshop-inspector"><div class="eyebrow">FALLTABELLEN</div><h2>@_lesson.Chapter.Substring(5)</h2>
                @if (_initial != null) { @foreach (var table in _initial.Structures) { <details class="schema-table" open><summary>@table.Key</summary><div class="schema-columns">@foreach (var column in table.Value.Rows) { <div><code>@column[0]</code><span>@column[1] · @(Equals(column[3], true) ? "NULL erlaubt" : "Pflichtfeld")</span></div> }</div></details> } }
            </aside>
        }
        else
        {
        <aside class="inspector workshop-inspector"><div class="eyebrow">DEINE WERKSTATT-TABELLEN</div><h2>Artikel & Konten</h2><details class="schema-table" open><summary>Artikel</summary><div class="schema-columns"><div><code>Id</code><span>int · PK</span></div><div><code>Name</code><span>nvarchar(60)</span></div><div><code>Kategorie</code><span>nvarchar(30)</span></div><div><code>Preis</code><span>decimal(12,4) · ≥ 0</span></div><div><code>Bestand</code><span>int</span></div><div><code>Aktiv</code><span>bit · 0 oder 1</span></div></div></details><details class="schema-table" open><summary>Konten</summary><div class="schema-columns"><div><code>Id</code><span>int · PK</span></div><div><code>Name</code><span>nvarchar(60)</span></div><div><code>Guthaben</code><span>decimal(10,2) · ≥ 0</span></div></div></details><p>Alle Ausgangsspalten sind Pflichtfelder. <code>Rueckgaben</code> entsteht erst durch deinen CREATE-TABLE-Auftrag.</p><p><strong>Wichtig:</strong> Zahlen im Skript verwenden einen Punkt, beispielsweise <code>44.90</code>. Texte stehen in einfachen Anführungszeichen.</p><p>Die Zusatzprüfung verwendet andere Preise, Beträge und weitere Artikel. Formuliere die Regel aus dem Auftrag allgemein.</p></aside>
        }
    </main>
}
