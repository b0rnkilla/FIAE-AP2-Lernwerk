@page "/sql-werkstatt"
@page "/sql-werkstatt/{LessonId:int}"
<PageTitle>@(_lesson?.Title ?? "SQL-Werkstatt") · AP2 Lernwerk</PageTitle>
@if (_loading && _lesson == null)
{
    <main class="page loading-state" role="status"><span class="eyebrow">GLEICH GEHT’S WEITER</span><h1>Deine Aufgabe wird geladen …</h1><p>Dein Entwurf und dein Fortschritt werden vorbereitet.</p></main>
}
else if (_lesson == null)
{
    <main class="page"><h1>Aufgabe nicht gefunden</h1><a href="/sql-werkstatt/1">Zur ersten Werkstattaufgabe</a></main>
}
else
{
    <main class="workspace workshop-workspace @(_progress.TaskListCollapsed ? "rail-collapsed" : "")">
        <TaskRail Id="task-list" Collapsed="_progress.TaskListCollapsed" CollapsedChanged="SetTaskListCollapsedAsync"><div class="eyebrow">SQL-WERKSTATT</div><h2>Daten ändern.<br />Regeln verstehen.</h2><div class="rail-progress"><span>@_progress.WorkshopLessons.Values.Count(x => x.Completed) / @Catalog.Lessons.Count gelöst</span><progress value="@_progress.WorkshopLessons.Values.Count(x => x.Completed)" max="@Catalog.Lessons.Count" aria-label="Fortschritt der SQL-Werkstatt"></progress></div><nav aria-label="Werkstattaufgaben auswählen">@foreach (var chapter in Catalog.Lessons.GroupBy(x => x.Chapter)) { <div class="chapter-label">@chapter.Key</div>@foreach (WorkshopLesson lesson in chapter) { bool completed = _progress.WorkshopLessons.TryGetValue(lesson.Id, out LessonProgress? saved) && saved.Completed;<a class="mission-link @(lesson.Id == _lesson.Id ? "selected" : "")" href="@($"/sql-werkstatt/{lesson.Id}")" aria-current="@(lesson.Id == _lesson.Id ? "step" : null)"><span class="mission-index @(completed ? "done" : "")">@(completed ? "✓" : lesson.Id.ToString("D2"))</span><span>@lesson.Title</span></a> } }</nav></TaskRail>
        <div class="mission-main">
            @* Während des Ladens bleibt dieselbe Aufgabenliste mit ihrer aktuellen Scrollposition erhalten. *@
            @if (_loading)
            {
                <div class="loading-state" role="status"><span class="eyebrow">GLEICH GEHT’S WEITER</span><h1>Deine Aufgabe wird geladen …</h1><p>Dein Entwurf und dein Fortschritt werden vorbereitet.</p></div>
            }
            else
            {
                <div class="mission-topline"><span class="eyebrow">WERKSTATT @_lesson.Id.ToString("D2") / @Catalog.Lessons.Count</span><span class="badge">@_lesson.Topic</span></div><h1>@_lesson.Title</h1>
                <LearningModePicker @key="_lesson.Id" ExamMode="_examMode" Busy="_busy" HasDraft="@(!string.IsNullOrWhiteSpace(_sql))" AssistedAttempt="_current.UsedAssistance" ModeChanged="SetModeAsync" />
                <p class="workshop-safety"><strong>Deine Arbeitskopie startet jedes Mal neu.</strong> Schreibe Tabellennamen ohne Präfix, zum Beispiel <code>Artikel</code>. Mehrere Befehle gehören gemeinsam in ein Skript. Änderungen betreffen nur diesen Versuch.</p>
                @if (_examMode) { <SelfTestHelp Hidden="_progress.SelfTestHelpDismissed" Busy="_busy" HiddenChanged="SetSelfTestHelpHiddenAsync"><strong>So funktioniert dein Selbsttest:</strong> Lies den Auftrag und die Ausgangsdaten. Schreibe dein Skript und klicke auf „Lösung prüfen“. Danach siehst du die Bewertung und den Zustand deiner Tabellen.</SelfTestHelp> }
                <section class="task-card"><div class="eyebrow">01 · AUFGABE VERSTEHEN</div><p>@_lesson.Task</p></section>
                <details class="workshop-detail initial-data"><summary>Ausgangsdaten ansehen</summary>@if (_initial == null) { <p>Die Ausgangsdaten werden geladen …</p> } else { <WorkshopResults Run="_initial" /> }</details>
                @if (!Database.Ready) { <p class="notice warning">@Database.Error <a href="/einrichtung#sql">SQL-Verbindung einrichten</a></p> }
                <section class="editor-card"><div class="editor-toolbar"><label for="workshop-editor">02 · Dein SQL-Skript</label><span>T-SQL · Microsoft SQL Server</span></div><textarea id="workshop-editor" class="sql-editor" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="Schreibe hier deine SQL-Anweisungen …" @bind="_sql" @bind:event="oninput" @onblur="SaveAsync" readonly="@_busy" aria-busy="@(_busy ? "true" : "false")"></textarea><div class="editor-actions"><div>@if (!_examMode) { <button class="button secondary" disabled="@(_busy || !Database.Ready)" @onclick="() => RunAsync(false)">Skript ausprobieren</button> }<button class="button primary" disabled="@(_busy || !Database.Ready || string.IsNullOrWhiteSpace(_sql))" @onclick="() => RunAsync(true)">@(_busy ? "Wird geprüft …" : "Lösung prüfen") →</button></div></div></section>
                @if (_storageError != null) { <p class="notice warning" role="alert">@_storageError</p> }
                @if (_evaluation != null) { <section class="feedback @(_evaluation.Correct ? "correct" : "retry")" role="status"><strong>@(_evaluation.TechnicalFailure ? "Technische Unterbrechung" : _evaluation.Correct ? "Die Änderung stimmt." : "Prüfe dein Skript noch einmal.")</strong><p>@_evaluation.Message</p>@if (_evaluation.Correct) { <p class="discovery">@_lesson.Discovery</p><AttemptOutcomeNote ExamMode="_examMode" AssistedAttempt="_current.UsedAssistance" /> }</section> }
                @if (_run != null && (_evaluation == null || _run.Error != _evaluation.Message)) { <div class="workshop-output"><h2>Stand nach deinem Skript</h2><WorkshopResults Run="_run" /></div> }
                @if (!_examMode)
                {
                    <section class="briefing"><h2>Das brauchst du für diese Aufgabe</h2><p>@_lesson.Briefing</p></section>
                    <section class="help-card">
                        <div class="help-row"><div><h2>Ein Denkanstoß für dein Skript</h2><p>Öffne nur so viel Hilfe, wie du gerade brauchst.</p></div><button class="button secondary" disabled="@(_busy || _current.HintLevel >= 3)" @onclick="ShowHintAsync">@(_current.HintLevel >= 3 ? "Alle Hinweise geöffnet" : $"Hinweis {_current.HintLevel + 1} von 3 öffnen")</button></div>
                        @for (int i = 0; i < _current.HintLevel; i++) { <div class="hint"><span>@(i + 1)</span><p>@_lesson.Hints[i]</p></div> }
                        <div class="help-row">
                            <div><h2>Syntax gerade nicht im Kopf?</h2><p>Im SQL-Spickzettel findest du Regeln und Beispiele.</p></div>
                            <a href="@($"/nachschlagen?zurueck=/sql-werkstatt/{_lesson.Id}")" class="button secondary">SQL-Spickzettel öffnen</a>
                        </div>
                        <div class="help-row">
                            <div><h2>Musterlösung</h2><p>Eine aufgedeckte Lösung zählt nicht als selbstständiger Versuch.</p></div>
                            <button class="button secondary" disabled="@_busy" aria-label="@(_showSolution ? "Musterlösung ausblenden" : "Musterlösung ansehen")" aria-expanded="@(_showSolution ? "true" : "false")" aria-controls="@(_showSolution ? "workshop-solution" : null)" @onclick="ToggleSolutionAsync">@(_showSolution ? "Ausblenden" : "Ansehen")</button>
                        </div>
                        @if (_showSolution) { <div id="workshop-solution" class="solution"><pre><code>@_lesson.ReferenceSql</code></pre><p>@_lesson.Explanation</p></div> }
                    </section>
                }
                <div class="mission-bottom">@if (_lesson.Id > 1) { <a class="button secondary" href="@($"/sql-werkstatt/{_lesson.Id - 1}")">← Vorherige Aufgabe</a> }<span></span>@if (_lesson.Id < Catalog.Lessons.Count) { <a class="button primary" href="@($"/sql-werkstatt/{_lesson.Id + 1}")">Nächste Aufgabe →</a> } else { <a class="button primary" href="/lernplan">Zur Wiederholung →</a> }</div>
            }
        </div>
        <aside class="inspector workshop-inspector"><div class="eyebrow">DEINE WERKSTATT-TABELLEN</div><h2>Artikel & Konten</h2><details class="schema-table" open><summary>Artikel</summary><div class="schema-columns"><div><code>Id</code><span>int · PK</span></div><div><code>Name</code><span>nvarchar(60)</span></div><div><code>Kategorie</code><span>nvarchar(30)</span></div><div><code>Preis</code><span>decimal(10,2) · ≥ 0</span></div><div><code>Bestand</code><span>int</span></div><div><code>Aktiv</code><span>bit · 0 oder 1</span></div></div></details><details class="schema-table" open><summary>Konten</summary><div class="schema-columns"><div><code>Id</code><span>int · PK</span></div><div><code>Name</code><span>nvarchar(60)</span></div><div><code>Guthaben</code><span>decimal(10,2) · ≥ 0</span></div></div></details><p>Alle Ausgangsspalten sind Pflichtfelder. <code>Rueckgaben</code> entsteht erst durch deinen CREATE-TABLE-Auftrag.</p><p><strong>Wichtig:</strong> Zahlen im Skript verwenden einen Punkt, beispielsweise <code>44.90</code>. Texte stehen in einfachen Anführungszeichen.</p><p>Die Zusatzprüfung verwendet andere Preise, Beträge und weitere Artikel. Formuliere die Regel aus dem Auftrag allgemein.</p></aside>
    </main>
}
