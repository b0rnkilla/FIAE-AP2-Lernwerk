@page "/lernplan"
@inject ProgressStore Store
@inject LessonCatalog Catalog
@inject WorkshopCatalog WorkshopCatalog
@inject AlgorithmCatalog AlgorithmCatalog
@inject BusinessCatalog BusinessCatalog
@inject DesignCatalog DesignCatalog
@inject UmlCatalog UmlCatalog
@inject SoftwareCatalog SoftwareCatalog
<PageTitle>Dein Lernplan · AP2 Lernwerk</PageTitle>
<main class="page reading-page">
    <div class="eyebrow">DEIN TEMPO · DEIN NÄCHSTER SCHRITT</div>
    <h1>Was sitzt schon?<br /><em>Was übst du als Nächstes?</em></h1>
    <p class="lead">Wähle eine neue Aufgabe oder greife eine offene Spur wieder auf. Dein Lernplan richtet sich nach deinem Fortschritt, unabhängig davon, wie viel Zeit du heute hast.</p>
    @if (_error != null)
    {
        <p class="notice warning" role="alert">@_error</p>
    }
    else
    {
        var nextInvestigation = Catalog.Lessons.FirstOrDefault(x => !_progress.Lessons.TryGetValue(x.Id, out LessonProgress? state) || !state.Completed && state.Attempts == 0 && string.IsNullOrWhiteSpace(state.Sql));
        var nextWorkshop = WorkshopCatalog.Lessons.FirstOrDefault(x => !_progress.WorkshopLessons.TryGetValue(x.Id, out LessonProgress? state) || !state.Completed && state.Attempts == 0 && string.IsNullOrWhiteSpace(state.Sql));
        var review = Catalog.Lessons.Where(x => _progress.Lessons.TryGetValue(x.Id, out LessonProgress? state) && state.Completed && !state.Independent).ToList();
        var workshopReview = WorkshopCatalog.Lessons.Where(x => _progress.WorkshopLessons.TryGetValue(x.Id, out LessonProgress? state) && state.Completed && !state.Independent).ToList();
        var open = Catalog.Lessons.Where(x => _progress.Lessons.TryGetValue(x.Id, out LessonProgress? state) && !state.Completed && (state.Attempts > 0 || !string.IsNullOrWhiteSpace(state.Sql))).ToList();
        var workshopOpen = WorkshopCatalog.Lessons.Where(x => _progress.WorkshopLessons.TryGetValue(x.Id, out LessonProgress? state) && !state.Completed && (state.Attempts > 0 || !string.IsNullOrWhiteSpace(state.Sql))).ToList();
        var nextAlgorithm = AlgorithmCatalog.Lessons.FirstOrDefault(x => !_progress.AlgorithmLessons.TryGetValue(x.Id, out AlgorithmProgress? state) || !state.Completed && state.Attempts == 0 && string.IsNullOrWhiteSpace(state.Draft));
        var algorithmOpen = AlgorithmCatalog.Lessons.Where(x => _progress.AlgorithmLessons.TryGetValue(x.Id, out AlgorithmProgress? state) && !state.Completed && (state.Attempts > 0 || !string.IsNullOrWhiteSpace(state.Draft))).ToList();
        var algorithmReview = AlgorithmCatalog.Lessons.Where(x => _progress.AlgorithmLessons.TryGetValue(x.Id, out AlgorithmProgress? state) && state.Completed && !state.Independent).ToList();
        <section class="plan-progress" aria-label="Dein Lernstand">
            <article><h2>Softwareplanung &amp; OOP</h2><strong>@_progress.SoftwareLessons.Values.Count(item => item.Completed) / @SoftwareCatalog.Lessons.Count gelöst</strong><p>@_progress.SoftwareLessons.Values.Count(item => item.Independent) davon auch ohne Hilfe</p></article>
            <article><h2>UML &amp; Modellierung</h2><strong>@_progress.UmlLessons.Values.Count(item => item.Completed) / @UmlCatalog.Lessons.Count gelöst</strong><p>@_progress.UmlLessons.Values.Count(item => item.Independent) davon auch ohne Hilfe</p></article>
            <article><h2>Datenbankentwurf</h2><strong>@_progress.DesignLessons.Values.Count(item => item.Completed) / @DesignCatalog.Lessons.Count gelöst</strong><p>@_progress.DesignLessons.Values.Count(item => item.Independent) davon auch ohne Hilfe</p></article>
            <article><h2>SQL-Ermittlung</h2><strong>@_progress.Lessons.Values.Count(x => x.Completed) / @Catalog.Lessons.Count gelöst</strong><p>@_progress.Lessons.Values.Count(x => x.Independent) davon auch ohne Hilfe</p></article>
            <article><h2>SQL-Werkstatt</h2><strong>@_progress.WorkshopLessons.Values.Count(x => x.Completed) / @WorkshopCatalog.Lessons.Count gelöst</strong><p>@_progress.WorkshopLessons.Values.Count(x => x.Independent) davon auch ohne Hilfe</p></article>
            <article><h2>Pseudocode &amp; Algorithmen</h2><strong>@_progress.AlgorithmLessons.Values.Count(x => x.Completed) / @AlgorithmCatalog.Lessons.Count gelöst</strong><p>@_progress.AlgorithmLessons.Values.Count(x => x.Independent) davon auch ohne Hilfe</p></article>
            <article><h2>Wirtschafts- &amp; Sozialkunde</h2><strong>@_progress.BusinessQuestions.Values.Count(x => x.Completed) / @BusinessCatalog.Questions.Count richtig gelöst</strong><p>@_progress.BusinessQuestions.Values.Count(x => x.NeedsReview) Antworten zum Wiederholen</p></article>
        </section>
        <section class="plan-step"><span class="eyebrow">ENTDECKEN</span><h2>Deine nächste neue Aufgabe</h2>
            @if (nextInvestigation == null && nextWorkshop == null && nextAlgorithm == null) { @if (open.Count + workshopOpen.Count + algorithmOpen.Count == 0) { <p>Alle @(Catalog.Lessons.Count + WorkshopCatalog.Lessons.Count + AlgorithmCatalog.Lessons.Count) Übungen aus SQL und Algorithmen sind gelöst. Wiederhole jetzt mit Abstand und ergänze unbekannte Aufgaben auf Papier.</p> } else { <p>Du hast alle Aufgaben aus SQL und Algorithmen bereits begonnen. Greife eine deiner offenen Aufgaben im nächsten Abschnitt wieder auf.</p> } }
            @if (nextInvestigation != null) { <a class="review-link" href="@($"/sql/{nextInvestigation.Id}")"><span>Ermittlung @nextInvestigation.Id.ToString("D2") · @nextInvestigation.Title</span><span>Weiter ermitteln →</span></a> }
            @if (nextWorkshop != null) { <a class="review-link" href="@($"/sql-werkstatt/{nextWorkshop.Id}")"><span>Werkstatt @nextWorkshop.Id.ToString("D2") · @nextWorkshop.Title</span><span>Weiter üben →</span></a> }
            @if (nextAlgorithm != null) { <a class="review-link" href="@($"/algorithmen/{nextAlgorithm.Id}")"><span>Algorithmen @nextAlgorithm.Id.ToString("D2") · @nextAlgorithm.Title</span><span>Weiter lernen →</span></a> }
        </section>
        <section class="plan-step"><span class="eyebrow">NOCH EINMAL ANSETZEN</span><h2>Begonnen, noch nicht gelöst</h2>
            @if (open.Count + workshopOpen.Count + algorithmOpen.Count == 0) { <p>Aktuell gibt es keine begonnenen, noch ungelösten Aufgaben.</p> }
            @foreach (Lesson lesson in open) { <a class="review-link" href="@($"/sql/{lesson.Id}")"><span>Ermittlung @lesson.Id.ToString("D2") · @lesson.Title</span><span>Erneut versuchen →</span></a> }
            @foreach (WorkshopLesson lesson in workshopOpen) { <a class="review-link" href="@($"/sql-werkstatt/{lesson.Id}")"><span>Werkstatt @lesson.Id.ToString("D2") · @lesson.Title</span><span>Erneut versuchen →</span></a> }
            @foreach (AlgorithmLesson lesson in algorithmOpen) { <a class="review-link" href="@($"/algorithmen/{lesson.Id}")"><span>Algorithmen @lesson.Id.ToString("D2") · @lesson.Title</span><span>Erneut versuchen →</span></a> }
        </section>
        <section class="plan-step"><span class="eyebrow">SELBSTSTÄNDIG FESTIGEN</span><h2>Gelöst – jetzt ohne Hilfe wiederholen</h2>
            @if (review.Count + workshopReview.Count + algorithmReview.Count == 0) { <p>Keine gelöste Aufgabe wartet auf ihren ersten Erfolg ohne Hilfe. Bereits selbstständig gelöste Aufgaben kannst du jederzeit über die Aufgabenliste wiederholen.</p> }
            @foreach (Lesson lesson in review) { <a class="review-link" href="@($"/sql/{lesson.Id}")"><span>Ermittlung @lesson.Id.ToString("D2") · @lesson.Title</span><span>Ohne Hilfe wiederholen →</span></a> }
            @foreach (WorkshopLesson lesson in workshopReview) { <a class="review-link" href="@($"/sql-werkstatt/{lesson.Id}")"><span>Werkstatt @lesson.Id.ToString("D2") · @lesson.Title</span><span>Ohne Hilfe wiederholen →</span></a> }
            @foreach (AlgorithmLesson lesson in algorithmReview) { <a class="review-link" href="@($"/algorithmen/{lesson.Id}")"><span>Algorithmen @lesson.Id.ToString("D2") · @lesson.Title</span><span>Ohne Hilfe wiederholen →</span></a> }
            <p class="plan-tip">Wähle in der Aufgabe „Ohne Hilfe lösen“. Bei einem übernommenen Entwurf startest du über „Neu ohne Hilfe starten“ einen frischen Versuch.</p>
        </section>
    }
    @if (_error == null)
    {
        <section class="plan-step"><span class="eyebrow">SOFTWAREPLANUNG &amp; OOP</span><h2>Deine Softwareentwürfe weiterentwickeln</h2>
            @foreach (var task in SoftwareCatalog.Lessons.Where(task => !_progress.SoftwareLessons.TryGetValue(task.Id, out var saved) || !saved.Completed).Take(3)) { <a class="review-link" href="@($"/softwareplanung/{task.Id}")"><span>@task.Title</span><span>Weiter lernen →</span></a> }
            @foreach (var task in SoftwareCatalog.Lessons.Where(task => _progress.SoftwareLessons.TryGetValue(task.Id, out var saved) && saved.Completed && !saved.Independent).Take(3)) { <a class="review-link" href="@($"/softwareplanung/{task.Id}")"><span>@task.Title</span><span>Ohne Hilfe wiederholen →</span></a> }
            <a class="button secondary" href="/softwareplanung/pruefung">Prüfung üben →</a>
        </section>
        <section class="plan-step"><span class="eyebrow">UML &amp; MODELLIERUNG</span><h2>Deine Softwaremodelle weiterentwickeln</h2>
            @foreach (var task in UmlCatalog.Lessons.Where(task => !_progress.UmlLessons.TryGetValue(task.Id, out var saved) || !saved.Completed).Take(3)) { <a class="review-link" href="@($"/uml/{task.Id}")"><span>@task.Title</span><span>Weiter lernen →</span></a> }
            @foreach (var task in UmlCatalog.Lessons.Where(task => _progress.UmlLessons.TryGetValue(task.Id, out var saved) && saved.Completed && !saved.Independent).Take(3)) { <a class="review-link" href="@($"/uml/{task.Id}")"><span>@task.Title</span><span>Ohne Hilfe wiederholen →</span></a> }
            <a class="button secondary" href="/uml/pruefung">Prüfung üben →</a>
        </section>
        <section class="plan-step"><span class="eyebrow">DATENBANKENTWURF</span><h2>Dein Modell weiterentwickeln</h2>
            @foreach (var task in DesignCatalog.Lessons.Where(task => !_progress.DesignLessons.TryGetValue(task.Id, out var saved) || !saved.Completed).Take(3)) { <a class="review-link" href="@($"/datenbankentwurf/{task.Id}")"><span>@task.Title</span><span>Weiter lernen →</span></a> }
            @foreach (var task in DesignCatalog.Lessons.Where(task => _progress.DesignLessons.TryGetValue(task.Id, out var saved) && saved.Completed && !saved.Independent).Take(3)) { <a class="review-link" href="@($"/datenbankentwurf/{task.Id}")"><span>@task.Title</span><span>Ohne Hilfe wiederholen →</span></a> }
            <a class="button secondary" href="/datenbankentwurf/pruefung">Prüfung üben →</a>
        </section>
    }
    @if (_error == null)
    {
        <section class="plan-step"><span class="eyebrow">WIRTSCHAFTS- &amp; SOZIALKUNDE</span><h2>Gezielt weiterlernen</h2>
            @if (_progress.BusinessRound is { FinishedUtc: null } round) { <a class="review-link" href="/wiso/runde"><span>@FiaeTrainer.Web.Components.Pages.BusinessHome.RoundName(round.Kind) · Aufgabe @(round.Index + 1) von @round.QuestionIds.Count</span><span>Runde fortsetzen →</span></a> }
            <p>@_progress.BusinessQuestions.Values.Count(x => x.NeedsReview) zuletzt falsche oder unsichere Antworten warten auf Wiederholung. Im WiSo-Training kannst du ein Thema wählen oder eine neue Prüfungsrunde beginnen.</p><a class="button secondary" href="/wiso">Zum WiSo-Training →</a>
        </section>
    }
    <section class="plan-step"><span class="eyebrow">DEINE LERNROUTINE</span><h2>Eine Aufgabe. Eine Erkenntnis. Später noch einmal.</h2><p>Löse eine Aufgabe selbst. Kläre danach gezielt die Stelle, an der du unsicher warst. Wiederhole sie später ohne Hilfe und formuliere die Lösung auch einmal auf Papier.</p><p>Halte in einer kurzen Fehlerliste fest: Was habe ich verwechselt? Woran erkenne ich es beim nächsten Mal? Plane zusätzlich eigene Zeit für Pseudocode und die übrigen AP2-Themen ein.</p><p>Die Fortschrittszahlen zeigen bearbeitete Aufgaben; sie sind keine Prüfungsnote oder Bestehensprognose.</p></section>
    <section class="reference-section"><h2>Bedienhinweise</h2><p>Den allgemeinen Hinweis „So funktioniert dein Selbsttest“ kannst du direkt an der Aufgabe ausblenden. Hier lässt er sich für alle SQL- und Algorithmus-Aufgaben wieder einschalten.</p><button class="button secondary" disabled="@(!_progress.SelfTestHelpDismissed || _error != null)" @onclick="RestoreSelfTestHelpAsync">@(_progress.SelfTestHelpDismissed ? "Selbsttest-Hinweise wieder anzeigen" : "Selbsttest-Hinweise sind eingeblendet")</button></section>
    <section class="reset-section"><h2>Ein frischer Start</h2><p>Der Lernstand gilt für dieses lokale Profil in allen Browsern. Ein Zurücksetzen entfernt Entwürfe, Hinweise und gelöste Aufgaben.</p>@if (!_confirmReset) { <button class="button secondary" @onclick="() => _confirmReset = true">Lernstand zurücksetzen …</button> } else { <div class="notice warning"><p>Alle gespeicherten Fortschritte dieses lokalen Profils wirklich löschen?</p><button class="button secondary" @onclick="() => _confirmReset = false">Abbrechen</button> <button class="button danger" @onclick="ResetAsync">Lernstand jetzt löschen</button></div> }</section>
</main>
@code {
    private TrainingProgress _progress = new();
    private bool _confirmReset;
    private string? _error;
    protected override async Task OnInitializedAsync()
    {
        try { _progress = await Store.LoadAsync(); }
        catch (Exception exception) when (exception is IOException or System.Text.Json.JsonException or UnauthorizedAccessException) { _error = "Der Lernstand konnte nicht gelesen werden. Prüfe die Hinweise in der Anleitung."; }
    }
    /// <summary> Stellt die für alle Aufgaben gemeinsam gespeicherte Selbsttest-Hilfe wieder her. </summary>
    private async Task RestoreSelfTestHelpAsync()
    {
        try { await Store.SetSelfTestHelpDismissedAsync(false); _progress.SelfTestHelpDismissed = false; }
        catch (Exception exception) when (exception is IOException or System.Text.Json.JsonException or UnauthorizedAccessException) { _error = "Die Anzeigeeinstellung konnte nicht gespeichert werden. Prüfe die Schreibrechte und den gespeicherten Lernstand."; }
    }

    private async Task ResetAsync()
    {
        try { await Store.ResetAsync(); _progress = new TrainingProgress(); _confirmReset = false; _error = null; }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException) { _error = "Der Lernstand konnte nicht zurückgesetzt werden. Prüfe die Schreibrechte."; }
    }
}
