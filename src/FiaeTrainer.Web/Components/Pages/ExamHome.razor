@page "/algorithmen/pruefung"
@page "/sql/pruefung"
@inject NavigationManager Navigation
@inject ProgressStore Store
@inject FiaeTrainer.Web.Exams.ExamService Exams
@inject DatabaseState Database
@using FiaeTrainer.Core.Exams
<PageTitle>@Label-Prüfung · AP2 Lernwerk</PageTitle>
<main class="page exam-home">
    <div class="eyebrow">DEIN WISSEN SELBSTSTÄNDIG ANWENDEN</div><h1>@Label unter Prüfungsbedingungen.</h1>
    <p class="lead">45 Minuten · @(Module == ExamModule.Sql ? "fünf Aufgaben an neuen Falltabellen" : "drei Aufgaben aus zehn eigenen Prüfungsaufgaben") · 50 Trainingspunkte</p>
    <section class="exam-introduction"><h2>Ein unbekannter Fall. Deine eigene Lösung.</h2><p>@(Module == ExamModule.Sql ? "Eine zusammenhängende Ausgangssituation mit Tabellen, Beziehungen und Beispieldaten. Jede Aufgabe verwendet eine frische Arbeitskopie; Lösungen bauen nicht auf vorherigen Änderungen auf." : "Zwei Programmier- oder Korrekturaufgaben und eine Analyseaufgabe. Der eigene Prüfungspool bleibt vom geführten Lernweg getrennt.")</p><ul><li>Du kannst zwischen Aufgaben wechseln und sie zur Kontrolle markieren.</li><li>Vor der Abgabe gibt es keine Hinweise, Musterlösungen oder Probeausführung.</li><li>Pause blendet die Aufgaben aus. Browser schließen oder App neu starten hält die Uhr nicht an.</li><li>Nachschlagen pausiert die Prüfung und kennzeichnet das Ergebnis dauerhaft als „mit Nachschlagen“.</li><li>Die eigene Punktevergabe ist keine amtliche IHK-Note. Dein Trainingsziel: mindestens 25 von 50 Punkten.</li></ul><p>Die Zeit beginnt erst mit „Prüfung starten“. Die Zeitansätze sind Schätzungen und werden anhand praktischer Durchläufe weiter abgestimmt.</p></section>
    @if (_error != null) { <p class="notice warning" role="alert">@_error</p> }
    @if (Module == ExamModule.Sql && !Database.Ready) { <p class="notice warning">Für SQL brauchst du eine eingerichtete Verbindung. <a href="/einrichtung#sql">SQL einrichten</a></p> }
    @if (_existing != null)
    {
        <section class="business-resume"><div><h2>@(_existing.Submitted ? "Deine letzte Abgabe" : "Deine Prüfung wartet auf dich.")</h2><p>@(_existing.EvaluatedUtc != null ? $"{_existing.Earned} von 50 Trainingspunkten" : _existing.Submitted ? "Die Abgabe ist gespeichert und wartet auf die Auswertung." : "Entwürfe und Restzeit sind gespeichert.")</p></div><a class="button primary" href="@RoundPath">@(_existing.Submitted ? "Zur Auswertung →" : "Prüfung fortsetzen →")</a></section>
    }
    @if (Module == ExamModule.Sql) { <label class="exam-case-choice">Prüfungsfall<select @bind="_case"><option value="">Zufälliger Fall</option>@foreach (var item in Exams.SqlCases) { <option value="@item.Id">@item.Title</option> }</select></label> }
    @if (_confirm)
    {
        <section class="notice warning" role="alert"><strong>Offene Prüfung ersetzen?</strong><p>Die Entwürfe des offenen Versuchs werden verworfen. Frühere bewertete Prüfungen und deine Lernaufgaben bleiben erhalten.</p><button class="button secondary" @onclick="() => _confirm = false">Abbrechen</button> <button class="button primary" disabled="@_busy" @onclick="StartAsync">Neuen Versuch starten</button></section>
    }
    else { <button class="button primary" disabled="@(_busy || Module == ExamModule.Sql && !Database.Ready)" @onclick="RequestStartAsync">Prüfung starten →</button> }
    @if (_history.Count > 0) { <section class="exam-history"><h2>Deine letzten Prüfungen</h2>@foreach (var item in _history) { <div><span>@item.SubmittedUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")@(item.UsedReference ? " · mit Nachschlagen" : "")</span><strong>@item.Earned / 50 Punkte</strong></div> }</section> }
</main>
@code {
    /// <summary> Eigene Modulzuordnung aus den beiden festen lokalen Routen. </summary>
    private ExamModule Module => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("sql/", StringComparison.Ordinal) ? ExamModule.Sql : ExamModule.Algorithms;
    private string Label => Module == ExamModule.Sql ? "SQL" : "Pseudocode";
    private string RoundPath => Module == ExamModule.Sql ? "/sql/pruefung/runde" : "/algorithmen/pruefung/runde";
    private ExamRound? _existing;
    private List<ExamRound> _history = [];
    private string _case = "";
    private string? _error;
    private bool _busy;
    private bool _confirm;
    protected override async Task OnParametersSetAsync()
    {
        try { TrainingProgress state = await Store.LoadAsync(); _existing = state.ExamRounds.GetValueOrDefault(Module); _history = state.ExamHistory.Where(round => round.Module == Module).OrderByDescending(round => round.SubmittedUtc).Take(5).ToList(); }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or System.Text.Json.JsonException) { _error = "Der Prüfungsstand konnte nicht geladen werden. Die Datei wird nicht überschrieben."; _busy = true; }
    }
    private async Task RequestStartAsync() { if (_existing is { EvaluatedUtc: null }) _confirm = true; else await StartAsync(); }
    private async Task StartAsync()
    {
        _busy = true;
        try { await Store.StartExamAsync(Exams.Create(Module, _case.Length == 0 ? null : _case), _confirm ? _existing?.Id : null); Navigation.NavigateTo(RoundPath); }
        catch (Exception exception) when (exception is IOException or InvalidOperationException or UnauthorizedAccessException) { _error = exception.Message; }
        finally { _busy = false; }
    }
}
