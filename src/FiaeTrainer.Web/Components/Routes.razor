<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        @if (routeData.PageType != typeof(Pages.Training.Sql) && routeData.PageType != typeof(Pages.Training.Workshop) && routeData.PageType != typeof(Pages.Training.Algorithms))
        {
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        }
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)"><main class="page"><h1>Diese Seite gibt es nicht.</h1><a class="button primary" href="/">Zur Übersicht</a></main></LayoutView>
    </NotFound>
</Router>
