@if (Task.Format == "Read")
{
    <UmlDiagram Task="Task" Model="Task.Starter" />
    <fieldset class="design-options" disabled="@ReadOnly"><legend>@(Task.CorrectIds.Count == 1 ? "Wähle eine Aussage." : $"Wähle {Task.CorrectIds.Count} Aussagen.")</legend>
        @foreach (var option in Task.Options) { <label><input type="@(Task.CorrectIds.Count == 1 ? "radio" : "checkbox")" name="@_group" checked="@Answer.SelectedIds.Contains(option.Key)" @onchange="() => SelectAsync(option.Key)" /> @option.Value</label> }
    </fieldset>
}
else
{
    <DiagramCanvas SelectedId="@_selected" ReadOnly="ReadOnly" CanUndo="_history.CanUndo" CanRedo="_history.CanRedo" Action="CanvasAsync">
        <Tools>
            <label>Elementart<select @bind="_newKind" disabled="@ReadOnly">@foreach (string kind in UmlKinds.NodeTypes(Task.DiagramType)) { <option value="@kind">@UmlKinds.Nodes[kind]</option> }</select></label>
            <button type="button" class="button secondary" disabled="@(ReadOnly || Answer.Model.Nodes.Count >= 16)" @onclick="AddNodeAsync">+ Element hinzufügen</button>
            @if (Task.DiagramType == "Sequence") { <button type="button" class="button secondary" disabled="@(ReadOnly || Answer.Model.Fragments.Count >= 4)" @onclick="AddFragmentAsync">+ Sequenzgruppe</button> }
        </Tools>
        <ChildContent><UmlDiagram Task="Task" Model="Answer.Model" Evaluation="Evaluation" /></ChildContent>
        <Inspector>
            <h3>Eigenschaften</h3>
            @if (_selected.Length == 0) { <p>Wähle ein Element oder eine Verbindung im Diagramm.</p> }
            <label>Auswahl<select value="@_selected" @onchange="args => _selected = args.Value?.ToString() ?? string.Empty"><option value="">Keine</option>@foreach (var item in Answer.Model.Nodes) { <option value="@item.Id">@(item.Name.Length > 0 ? item.Name : UmlKinds.Nodes[item.Kind])</option> }@foreach (var item in Answer.Model.Links) { <option value="@item.Id">Verbindung @(Answer.Model.Links.IndexOf(item) + 1)</option> }@foreach (var item in Answer.Model.Fragments) { <option value="@item.Id">Gruppe @(Answer.Model.Fragments.IndexOf(item) + 1) · @item.Kind</option> }</select></label>
            @if (Task.DiagramType == "UseCase") { <label>Systemgrenze<input maxlength="80" disabled="@ReadOnly" @bind="Answer.Model.SystemName" @bind:after="ChangedAsync" /></label> }
    @foreach (var node in Answer.Model.Nodes.Where(item => item.Id == _selected))
    {
        <fieldset class="uml-node-editor" disabled="@ReadOnly" @key="node.Id"><legend>Element @(Answer.Model.Nodes.IndexOf(node) + 1)</legend>
            <div class="uml-fields">
            <label>Elementart<select @bind="node.Kind" @bind:after="ChangedAsync">@foreach (string kind in UmlKinds.NodeTypes(Task.DiagramType)) { <option value="@kind">@UmlKinds.Nodes[kind]</option> }</select></label>
            @if (!UmlNames.Structural(node.Kind)) { <label>Name<input maxlength="80" value="@node.Name" @onchange="args => RenameNodeAsync(node, args.Value?.ToString() ?? string.Empty)" /></label> }
            @if (Task.DiagramType == "Class" && node.Kind == "Class") { <label class="uml-checkbox"><input type="checkbox" @bind="node.Abstract" @bind:after="ChangedAsync" /> Abstrakte Klasse</label> }
            @if (Task.Lanes.Count > 0) { <label>Verantwortungsbereich<input maxlength="80" value="@Task.Lanes.GetValueOrDefault(node.Lane, node.Lane)" @onchange="async args => { if (!ReadOnly) { node.Lane = args.Value?.ToString() ?? string.Empty; await ChangedAsync(); } }" /></label> }
            </div>
            @if (Task.DiagramType == "Class" || Task.DiagramType == "State" && node.Kind == "State")
            {
                @foreach (var member in node.Members)
                {
                    <div class="uml-member" @key="member.Id"><div class="uml-fields">

                        <label>Merkmalart<select @bind="member.Kind" @bind:after="ChangedAsync">@if (Task.DiagramType == "Class") { <option value="Attribute">Attribut</option><option value="Method">Methode</option> } else { <option value="Entry">entry · beim Eintritt</option><option value="Do">do · während des Zustands</option><option value="Exit">exit · beim Verlassen</option> }</select></label>
                        <label>Name<input maxlength="80" value="@member.Name" @onchange="args => RenameMemberAsync(member, args.Value?.ToString() ?? string.Empty)" /></label>
                        @if (Task.DiagramType == "Class")
                        {
                            <label>@(member.Kind == "Method" ? "Rückgabetyp" : "Datentyp")<input maxlength="80" @bind="member.Type" @bind:after="ChangedAsync" placeholder="z. B. Integer, String, Boolean, Void" /></label>
                            <label>Sichtbarkeit<select @bind="member.Visibility" @bind:after="ChangedAsync"><option value="-">− privat</option><option value="+">+ öffentlich</option><option value="#"># geschützt</option><option value="~">~ paketintern</option></select></label>
                            <label class="uml-checkbox"><input type="checkbox" @bind="member.Static" @bind:after="ChangedAsync" /> Statisch</label>
                            @if (member.Kind == "Method") { <label>Parameter (name: Typ, …)<input maxlength="250" @bind="member.Parameters" @bind:after="ChangedAsync" placeholder="Leer lassen, wenn keine Parameter nötig sind" /></label><label class="uml-checkbox"><input type="checkbox" @bind="member.Abstract" @bind:after="ChangedAsync" /> Abstrakte Methode</label> }
                        }
                    </div><button class="design-remove" @onclick="() => RemoveMemberAsync(node, member)">Merkmal entfernen</button></div>
                }
                <button class="button secondary" disabled="@(node.Members.Count >= 16 || Task.MemberVocabulary.Count == 0)" @onclick="() => AddMemberAsync(node)">+ @(Task.DiagramType == "State" ? "Zustandsaktion" : "Attribut / Methode")</button>
            }
            <button class="design-remove" @onclick="() => RemoveNodeAsync(node)">Element entfernen</button>
        </fieldset>
    }
    @if (Task.DiagramType == "Sequence")
    {
        @foreach (var fragment in Answer.Model.Fragments.Where(item => item.Id == _selected))
        {
            <fieldset class="uml-fragment-editor" disabled="@ReadOnly" @key="fragment.Id"><legend>Sequenzgruppe @(Answer.Model.Fragments.IndexOf(fragment) + 1)</legend><div class="uml-fields">

                <label>Gruppenart<select @bind="fragment.Kind" @bind:after="ChangedAsync"><option value="alt">alt · Alternativen</option><option value="opt">opt · optional</option><option value="loop">loop · Wiederholung</option></select></label>
                <label>Gruppenbedingung<input maxlength="80" value="@Task.Conditions.GetValueOrDefault(fragment.Guard, fragment.Guard)" @onchange="async args => { if (!ReadOnly) { fragment.Guard = args.Value?.ToString() ?? string.Empty; await ChangedAsync(); } }" /></label>
            </div><button class="design-remove" @onclick="() => RemoveFragmentAsync(fragment)">Gruppe entfernen</button></fieldset>
        }
    }
    @foreach (var link in Answer.Model.Links.Where(item => item.Id == _selected))
    {
        <fieldset class="uml-link-editor" disabled="@ReadOnly" @key="link.Id"><legend>@(Task.DiagramType == "Sequence" ? "Nachricht" : "Verbindung") @(Answer.Model.Links.IndexOf(link) + 1)</legend><div class="uml-fields">
            <label>Ausgang / Absender<select @bind="link.Source" @bind:after="ChangedAsync"><option value="">Bitte wählen</option>@foreach (var node in Answer.Model.Nodes) { <option value="@node.Id">@node.Name</option> }</select></label>
            <label>Ziel / Empfänger<select @bind="link.Target" @bind:after="ChangedAsync"><option value="">Bitte wählen</option>@foreach (var node in Answer.Model.Nodes) { <option value="@node.Id">@node.Name</option> }</select></label>
            <label>Verbindungsart<select @bind="link.Kind" @bind:after="ChangedAsync">@foreach (string kind in UmlKinds.LinkTypes(Task.DiagramType)) { <option value="@kind">@UmlKinds.Links[kind]</option> }</select></label>
            @if (Task.DiagramType == "Class" && link.Kind is "Association" or "Aggregation" or "Composition") { <label>Multiplizität am Ausgang<input maxlength="12" @bind="link.SourceMultiplicity" @bind:after="ChangedAsync" placeholder="z. B. 1 oder 0..*" /></label><label>Multiplizität am Ziel<input maxlength="12" @bind="link.TargetMultiplicity" @bind:after="ChangedAsync" placeholder="z. B. 1 oder 0..*" /></label> }
            @if (Task.DiagramType is "Sequence" or "State")
            {
                <label>@(Task.DiagramType == "Sequence" ? "Nachricht" : "Ereignis")<input maxlength="80" value="@link.Name" @onchange="args => RenameLinkAsync(link, args.Value?.ToString() ?? string.Empty)" /></label>
            }
            @if (Task.Conditions.Count > 0) { <label>Bedingung am Übergang / Zweig<input maxlength="80" value="@Task.Conditions.GetValueOrDefault(link.Guard, link.Guard)" @onchange="async args => { if (!ReadOnly) { link.Guard = args.Value?.ToString() ?? string.Empty; await ChangedAsync(); } }" /></label> }
            @if (Task.DiagramType == "Sequence") { <label>Sequenzgruppe<select @bind="link.Fragment" @bind:after="ChangedAsync"><option value="">Außerhalb einer Gruppe</option>@foreach (var fragment in Answer.Model.Fragments) { <option value="@fragment.Id">Gruppe @(Answer.Model.Fragments.IndexOf(fragment) + 1) · @fragment.Kind</option> }</select></label> }
        </div>
        @if (Task.DiagramType == "Sequence") { <div class="uml-order"><button class="button secondary" disabled="@(Answer.Model.Links.IndexOf(link) == 0)" @onclick="() => MoveAsync(link, -1)">↑ Früher</button><button class="button secondary" disabled="@(Answer.Model.Links.IndexOf(link) == Answer.Model.Links.Count - 1)" @onclick="() => MoveAsync(link, 1)">↓ Später</button></div> }
        <button class="design-remove" @onclick="() => RemoveLinkAsync(link)">@(Task.DiagramType == "Sequence" ? "Nachricht" : "Verbindung") entfernen</button></fieldset>
    }
        </Inspector>
    </DiagramCanvas>
}
@code {
    private readonly DiagramHistory<UmlModel> _history = new();
    private UmlAnswer? _current;
    private string _selected = "", _newKind = "Class";
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_current, Answer)) { _current = Answer; _selected = Answer.Model.Nodes.FirstOrDefault()?.Id ?? ""; _history.Reset(Answer.Model); }
        if (!UmlKinds.NodeTypes(Task.DiagramType).Contains(_newKind)) _newKind = UmlKinds.NodeTypes(Task.DiagramType)[0];
    }
    private async System.Threading.Tasks.Task RenameNodeAsync(UmlNode node, string value) { if (ReadOnly || value.Length > 80) return; node.Name = value; node.Key = ""; await ChangedAsync(); }
    private async System.Threading.Tasks.Task RenameMemberAsync(UmlMember member, string value) { if (ReadOnly || value.Length > 80) return; member.Name = value; member.Key = ""; await ChangedAsync(); }
    private async System.Threading.Tasks.Task RenameLinkAsync(UmlLink link, string value) { if (ReadOnly || value.Length > 80) return; link.Name = value; link.Meaning = ""; await ChangedAsync(); }
    /// <summary> Prüft jede Geste gegen die aktuelle Antwort; Koordinaten bleiben unbenotet. </summary>
    private async System.Threading.Tasks.Task CanvasAsync(DiagramAction action)
    {
        if (action.Kind == "select") { _selected = action.Id; return; }
        if (ReadOnly) return;
        var node = Answer.Model.Nodes.FirstOrDefault(item => item.Id == action.Id);
        var link = Answer.Model.Links.FirstOrDefault(item => item.Id == action.Id);
        if (action.Kind is "undo" or "redo") { var model = _history.Move(action.Kind == "undo" ? -1 : 1); if (model != null) { Answer.Model = model; await Changed.InvokeAsync(); } return; }
        if (action.Kind == "layout") Answer.Model.Positions.Clear();
        else if (action.Kind == "rename") { if (node != null && !UmlNames.Structural(node.Kind)) await RenameNodeAsync(node, action.Text); else if (link != null) await RenameLinkAsync(link, action.Text); return; }
        else if (action.Kind == "delete") { if (node != null) await RemoveNodeAsync(node); else if (link != null) await RemoveLinkAsync(link); return; }
        else if (action.Kind == "connect" && node != null && Answer.Model.Nodes.Any(item => item.Id == action.Target) && Answer.Model.Links.Count < 32)
        {
            var added = new UmlLink { Source = node.Id, Target = action.Target, Kind = UmlKinds.LinkTypes(Task.DiagramType)[0] }; Answer.Model.Links.Add(added); _selected = added.Id;
        }
        else if (action.Kind == "move" && node != null)
        {
            var box = UmlLayout.Place(Task, Answer.Model)[node.Id];
            Answer.Model.Positions[node.Id] = new(Math.Clamp(box.X + Math.Clamp(action.X, -8000, 8000), 0, 8000), Task.DiagramType == "Sequence" ? box.Y : Math.Clamp(box.Y + Math.Clamp(action.Y, -8000, 8000), 0, 8000));
        }
        else if (action.Kind == "move" && link != null && Task.DiagramType == "Sequence" && action.Y != 0)
        {
            int before = Answer.Model.Links.IndexOf(link), after = Math.Clamp(before + (Math.Abs(action.Y) < 76 ? Math.Sign(action.Y) : action.Y / 76), 0, Answer.Model.Links.Count - 1);
            Answer.Model.Links.RemoveAt(before); Answer.Model.Links.Insert(after, link);
        }
        else return;
        await ChangedAsync();
    }

    /// <summary> Fachvokabular und erlaubte Diagrammart. </summary>
    [Parameter, EditorRequired] public UmlAssignment Task { get; set; } = new();
    /// <summary> Eigener, vollständig strukturierter Entwurf. </summary>
    [Parameter, EditorRequired] public UmlAnswer Answer { get; set; } = new();
    /// <summary> Übernimmt jede Eingabe in den getrennten Lernstand. </summary>
    [Parameter] public EventCallback Changed { get; set; }
    /// <summary> Gesperrte Abgaben können auch über die Handler nicht verändert werden. </summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary> Aktuelle Fehlermarkierungen verschwinden nach einer Änderung. </summary>
    [Parameter] public UmlEvaluation? Evaluation { get; set; }
    private readonly string _group = "uml-choice-" + Guid.NewGuid().ToString("N");
    private async System.Threading.Tasks.Task ChangedAsync() { if (ReadOnly) return; _history.Record(Answer.Model); await Changed.InvokeAsync(); }
    private async System.Threading.Tasks.Task SelectAsync(string id) { if (ReadOnly || !Task.Options.ContainsKey(id)) return; if (Task.CorrectIds.Count == 1) Answer.SelectedIds = [id]; else if (!Answer.SelectedIds.Remove(id)) Answer.SelectedIds.Add(id); await ChangedAsync(); }
    private async System.Threading.Tasks.Task AddNodeAsync() { if (ReadOnly || Answer.Model.Nodes.Count >= 16) return; var node = new UmlNode { Kind = _newKind, Name = UmlNames.Structural(_newKind) ? "" : "Neues Element" }; Answer.Model.Nodes.Add(node); _selected = node.Id; await ChangedAsync(); }
    private async System.Threading.Tasks.Task RemoveNodeAsync(UmlNode node) { if (ReadOnly) return; Answer.Model.Nodes.Remove(node); Answer.Model.Positions.Remove(node.Id); Answer.Model.Links.RemoveAll(link => link.Source == node.Id || link.Target == node.Id); await ChangedAsync(); }
    private async System.Threading.Tasks.Task NodeMeaningAsync(UmlNode node, string key) { if (ReadOnly || key.Length > 0 && !Task.NodeVocabulary.ContainsKey(key)) return; node.Key = key; node.Name = Task.NodeVocabulary.GetValueOrDefault(key, ""); await ChangedAsync(); }
    private async System.Threading.Tasks.Task AddMemberAsync(UmlNode node) { if (ReadOnly || node.Members.Count >= 16) return; node.Members.Add(new() { Kind = Task.DiagramType == "State" ? "Entry" : "Attribute" }); await ChangedAsync(); }
    private async System.Threading.Tasks.Task RemoveMemberAsync(UmlNode node, UmlMember member) { if (ReadOnly) return; node.Members.Remove(member); await ChangedAsync(); }
    private async System.Threading.Tasks.Task MemberMeaningAsync(UmlMember member, string key) { if (ReadOnly || key.Length > 0 && !Task.MemberVocabulary.ContainsKey(key)) return; member.Key = key; member.Name = Task.MemberVocabulary.GetValueOrDefault(key, ""); await ChangedAsync(); }
    private async System.Threading.Tasks.Task AddLinkAsync() { if (ReadOnly || Answer.Model.Nodes.Count == 0 || Answer.Model.Links.Count >= 32) return; Answer.Model.Links.Add(new() { Kind = UmlKinds.LinkTypes(Task.DiagramType)[0] }); await ChangedAsync(); }
    private async System.Threading.Tasks.Task RemoveLinkAsync(UmlLink link) { if (ReadOnly) return; Answer.Model.Links.Remove(link); await ChangedAsync(); }
    private async System.Threading.Tasks.Task LinkMeaningAsync(UmlLink link, string key) { var vocabulary = Task.DiagramType == "State" ? Task.Events : Task.Messages; if (ReadOnly || key.Length > 0 && !vocabulary.ContainsKey(key)) return; link.Meaning = key; link.Name = vocabulary.GetValueOrDefault(key, ""); await ChangedAsync(); }
    private async System.Threading.Tasks.Task AddFragmentAsync() { if (ReadOnly || Answer.Model.Fragments.Count >= 4) return; var fragment = new UmlFragment(); Answer.Model.Fragments.Add(fragment); _selected = fragment.Id; await ChangedAsync(); }
    private async System.Threading.Tasks.Task RemoveFragmentAsync(UmlFragment fragment) { if (ReadOnly) return; Answer.Model.Fragments.Remove(fragment); foreach (var link in Answer.Model.Links.Where(link => link.Fragment == fragment.Id)) link.Fragment = ""; await ChangedAsync(); }
    private async System.Threading.Tasks.Task MoveAsync(UmlLink link, int direction) { if (ReadOnly || direction is not (-1 or 1)) return; int index = Answer.Model.Links.IndexOf(link), next = index + direction; if (index < 0 || next < 0 || next >= Answer.Model.Links.Count) return; (Answer.Model.Links[index], Answer.Model.Links[next]) = (Answer.Model.Links[next], Answer.Model.Links[index]); await ChangedAsync(); }
}
