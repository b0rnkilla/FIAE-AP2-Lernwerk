<div class="uml-diagram-tools"><span class="badge">@UmlKinds.Diagrams[Task.DiagramType]</span><button class="button secondary" type="button" aria-pressed="@(_zoom ? "true" : "false")" @onclick="() => _zoom = !_zoom">@(_zoom ? "Diagramm verkleinern" : "Diagramm vergrößern")</button></div>
<div class="design-diagram-wrap uml-canvas" tabindex="0" role="region" aria-label="UML-Diagramm – bei Bedarf seitlich scrollen">
@if (Model.Nodes.Count == 0) { <p class="uml-empty">Deine Arbeitsfläche ist noch leer. Lege darunter die benötigten Elemente an und verbinde sie.</p> }
else
{
    <svg class="design-diagram uml-svg" data-diagram-type="@Task.DiagramType" viewBox="0 0 @Width @Height" style="@(_zoom ? $"min-width:{Width}px;width:150%" : "min-width:560px")" role="img" aria-labelledby="@(_id + "-title") @(_id + "-desc")">
        <title id="@(_id + "-title")">@UmlKinds.Diagrams[Task.DiagramType]</title><desc id="@(_id + "-desc")">@Description</desc>
        <defs>
            <marker id="@(_id + "-arrow")" viewBox="0 0 12 12" markerWidth="10" markerHeight="10" refX="11" refY="6" orient="auto"><path d="M 1 1 L 11 6 L 1 11" class="uml-open-arrow" /></marker>
            <marker id="@(_id + "-call")" viewBox="0 0 12 12" markerWidth="10" markerHeight="10" refX="11" refY="6" orient="auto"><path d="M 1 1 L 11 6 L 1 11 Z" class="uml-call-arrow" /></marker>
            <marker id="@(_id + "-triangle")" viewBox="0 0 14 14" markerWidth="14" markerHeight="14" refX="13" refY="7" orient="auto"><path d="M 1 1 L 13 7 L 1 13 Z" class="uml-hollow" /></marker>
            <marker id="@(_id + "-diamond")" viewBox="0 0 20 14" markerWidth="18" markerHeight="14" refX="19" refY="7" orient="auto"><path d="M 1 7 L 10 1 L 19 7 L 10 13 Z" class="uml-hollow" /></marker>
            <marker id="@(_id + "-filled")" viewBox="0 0 20 14" markerWidth="18" markerHeight="14" refX="19" refY="7" orient="auto"><path d="M 1 7 L 10 1 L 19 7 L 10 13 Z" class="uml-filled" /></marker>
        </defs>
        @if (Task.DiagramType == "UseCase" && !string.IsNullOrWhiteSpace(Model.SystemName)) { <rect x="240" y="15" width="550" height="@(Height - 35)" class="uml-boundary" /><g><text x="260" y="40" class="design-node-title">@Short(Model.SystemName)</text></g> }
        @if (Task.DiagramType == "Activity" && Task.Lanes.Count > 0)
        {
            @for (int i = 0; i < Task.Lanes.Count; i++) { <g><rect x="@(i * 260 + 5)" y="5" width="260" height="@(Height - 15)" class="uml-boundary" /><g><text x="@(i * 260 + 20)" y="30" class="design-node-title">@Task.Lanes.ElementAt(i).Value</text></g></g> }
        }
        @if (Task.DiagramType == "Sequence")
        {
            @foreach (var fragment in Model.Fragments)
            {
                var indexes = Model.Links.Select((link, index) => (link, index)).Where(item => item.link.Fragment == fragment.Id).Select(item => item.index).ToArray();
                @if (indexes.Length > 0)
                {
                    int top = 100 + indexes.Min() * 76, bottom = 170 + indexes.Max() * 76;
                    <g><rect x="12" y="@top" width="@(Width - 24)" height="@(bottom - top)" class="uml-fragment" /><g><text x="22" y="@(top + 18)" class="design-node-column">@fragment.Kind @(fragment.Guard.Length > 0 ? "[" + Task.Conditions.GetValueOrDefault(fragment.Guard, "?") + "]" : "")</text></g>
                    @if (fragment.Kind == "alt")
                    {
                        @foreach (int index in indexes.Skip(1).Where(index => Model.Links[index].Guard != Model.Links[index - 1].Guard)) { <line x1="12" x2="@(Width - 12)" y1="@(122 + index * 76)" y2="@(122 + index * 76)" class="uml-fragment-divider" /> }
                    }</g>
                }
            }
            @foreach (var node in Model.Nodes)
            {
                var box = Boxes[node.Id];
                <line x1="@(box.X + box.Width / 2)" x2="@(box.X + box.Width / 2)" y1="78" y2="@(Height - 25)" class="uml-lifeline" />
            }
            @for (int i = 0; i < Model.Links.Count; i++)
            {
                var link = Model.Links[i];
                @if (Boxes.TryGetValue(link.Source, out var from) && Boxes.TryGetValue(link.Target, out var to))
                {
                    int x1 = from.X + from.Width / 2, x2 = to.X + to.Width / 2, y = 150 + i * 76;
                    @if (link.Kind == "Message")
                    {
                        int response = Model.Links.FindIndex(i + 1, candidate => candidate.Kind == "Return" && candidate.Source == link.Target && candidate.Target == link.Source);
                        if (response >= 0 && Model.Fragments.Any(fragment => fragment.Id == Model.Links[response].Fragment && fragment.Kind == "alt")) response = Model.Links.FindLastIndex(candidate => candidate.Kind == "Return" && candidate.Source == link.Target && candidate.Target == link.Source && candidate.Fragment == Model.Links[response].Fragment);
                        <rect x="@(x2 - 6)" y="@y" width="12" height="@(response > i ? (response - i) * 76 : 26)" class="uml-activation" />
                    }
                    <g class="@(WrongLink(link.Id) ? "uml-wrong" : null)"><path d="@(x1 == x2 ? $"M{x1} {y} h60 v30 h-60" : $"M{x1} {y} H{x2}")" class="uml-edge @(link.Kind == "Return" ? "uml-dashed" : "")" marker-end="url(#@(_id + (link.Kind == "Message" ? "-call" : "-arrow")))" /><g><text x="@(Math.Min(x1, x2) + 12)" y="@(y - 10)" class="design-node-column">@(i + 1). @Short(LinkLabel(link), 42)<title>@LinkLabel(link)</title></text></g></g>
                }
            }
        }
        else
        {
            @foreach (var link in Model.Links)
            {
                @if (Boxes.TryGetValue(link.Source, out var from) && Boxes.TryGetValue(link.Target, out var to))
                {
                    var points = ConnectionPoints(link, from, to);
                    <g class="@(WrongLink(link.Id) ? "uml-wrong" : null)"><path d="@Path(link, from, to)" class="uml-edge @(link.Kind is "Include" or "Extend" or "Realization" ? "uml-dashed" : "")" marker-end="@Marker(link)"><title>@LinkText(link)</title></path>
                    <g><text x="@((points.X1 + points.X2) / 2 + 8)" y="@((points.Y1 + points.Y2) / 2 - 10)" class="design-node-column">@Short(LinkLabel(link), 30)<title>@LinkLabel(link)</title></text></g>
                    @if (Task.DiagramType == "Class" && link.Kind is "Association" or "Aggregation" or "Composition")
                    {
                        var sourceLabel = MultiplicityLabel(from, points.X1, points.Y1); var targetLabel = MultiplicityLabel(to, points.X2, points.Y2);
                        <g><text x="@sourceLabel.X" y="@sourceLabel.Y" text-anchor="@sourceLabel.Anchor" class="design-node-column">@link.SourceMultiplicity</text></g><g><text x="@targetLabel.X" y="@targetLabel.Y" text-anchor="@targetLabel.Anchor" class="design-node-column">@link.TargetMultiplicity</text></g>
                    }
                    </g>
                }
            }
        }
        @foreach (var node in Model.Nodes)
        {
            var box = Boxes[node.Id]; int x = box.X, y = box.Y, center = x + box.Width / 2;
            <g class="@(WrongNode(node.Id) ? "uml-wrong" : null)">
                @if (node.Kind == "Actor") { <circle cx="@center" cy="@(y + 16)" r="13" class="uml-hollow" /><path d="@($"M{center} {y+29} v35 M{center-22} {y+40} h44 M{center} {y+64} l-20,22 M{center} {y+64} l20,22")" class="uml-edge" /><g><text x="@center" y="@(y + 107)" text-anchor="middle" class="design-node-column">@Short(node.Name)</text></g> }
                else if (node.Kind == "UseCase") { <ellipse cx="@center" cy="@(y + box.Height / 2)" rx="@(box.Width / 2)" ry="@(box.Height / 2)" class="design-node" /><g><text x="@center" y="@(y + box.Height / 2 + 5)" text-anchor="middle" class="design-node-column">@Short(node.Name)</text></g> }
                else if (node.Kind is "Initial" or "Final") { <circle cx="@center" cy="@(y + 17)" r="16" class="@(node.Kind == "Initial" ? "uml-filled" : "uml-hollow")" />@if (node.Kind == "Final") { <circle cx="@center" cy="@(y + 17)" r="10" class="uml-filled" /> } }
                else if (node.Kind is "Decision" or "Merge") { <polygon points="@($"{x},{y+box.Height/2} {center},{y} {x+box.Width},{y+box.Height/2} {center},{y+box.Height}")" class="design-node" /><g><text x="@center" y="@(y - 10)" text-anchor="middle" class="design-node-column">@Short(node.Name)</text></g> }
                else if (node.Kind is "Fork" or "Join") { <rect x="@x" y="@y" width="@box.Width" height="@box.Height" class="uml-filled" /><g><text x="@center" y="@(y - 10)" text-anchor="middle" class="design-node-column">@Short(node.Name)</text></g> }
                else
                {
                    <rect x="@x" y="@y" width="@box.Width" height="@box.Height" rx="@(node.Kind is "Action" or "State" ? 16 : 0)" class="design-node" />
                    @if (node.Kind == "Interface") { <g><text x="@center" y="@(y + 20)" text-anchor="middle" class="design-node-column">«interface»</text></g> }
                    <g><text x="@center" y="@(y + (node.Kind == "Interface" ? 43 : 28))" text-anchor="middle" class="design-node-title @(node.Abstract ? "uml-abstract" : null)">@Short(node.Name, Task.DiagramType == "Sequence" ? 20 : 24)<title>@node.Name</title></text></g>
                    @if (node.Kind is "Class" or "Interface")
                    {
                        var attributes = node.Members.Where(member => member.Kind == "Attribute").ToArray();
                        var methods = node.Members.Where(member => member.Kind == "Method").ToArray();
                        <line x1="@x" x2="@(x + box.Width)" y1="@(y + 51)" y2="@(y + 51)" class="uml-divider" />
                        @for (int i = 0; i < attributes.Length; i++) { var member = attributes[i]; <g><text x="@(x + 10)" y="@(y + 73 + i * 28)" class="design-node-column @(member.Static ? "uml-static" : null)">@Short(MemberText(member), 37)<title>@MemberText(member)</title></text></g> }
                        <line x1="@x" x2="@(x + box.Width)" y1="@(y + 67 + attributes.Length * 28)" y2="@(y + 67 + attributes.Length * 28)" class="uml-divider" />
                        @for (int i = 0; i < methods.Length; i++) { var member = methods[i]; <g><text x="@(x + 10)" y="@(y + 89 + attributes.Length * 28 + i * 28)" class="design-node-column @(member.Static ? "uml-static" : null) @(member.Abstract ? "uml-abstract" : null)">@Short(MemberText(member), 37)<title>@MemberText(member)</title></text></g> }
                    }
                    else if (node.Members.Count > 0)
                    {
                        <line x1="@x" x2="@(x + box.Width)" y1="@(y + 51)" y2="@(y + 51)" class="uml-divider" />
                        @for (int i = 0; i < node.Members.Count; i++) { var member = node.Members[i]; <g><text x="@(x + 10)" y="@(y + 73 + i * 28)" class="design-node-column @(member.Static ? "uml-static" : null) @(member.Abstract ? "uml-abstract" : null)">@Short(MemberText(member), 37)<title>@MemberText(member)</title></text></g> }
                    }
                }
            </g>
        }
    </svg>
}
</div>
@if (Model.Nodes.Count > 0)
{
    <details class="uml-text-model"><summary>Diagramm als Text lesen</summary><ul>@foreach (var node in Model.Nodes) { <li><strong>@node.Name</strong> · @UmlKinds.Nodes.GetValueOrDefault(node.Kind, node.Kind)@(node.Abstract ? " · abstrakt" : "") @(node.Lane.Length > 0 ? " · " + Task.Lanes.GetValueOrDefault(node.Lane, "?") : "")<ul>@foreach (var member in node.Members) { <li>@MemberText(member)</li> }</ul></li> }</ul><ol>@foreach (var link in Model.Links) { <li>@LinkText(link)</li> }</ol></details>
}
@code {
    /// <summary> Aufgabenwortschatz für Beschriftungen und Notation. </summary>
    [Parameter, EditorRequired] public UmlAssignment Task { get; set; } = new();
    /// <summary> Anzeige verändert den Fachentwurf nicht. </summary>
    [Parameter, EditorRequired] public UmlModel Model { get; set; } = new();
    /// <summary> Markierungen beziehen sich ausschließlich auf die zuletzt geprüfte Antwort. </summary>
    [Parameter] public UmlEvaluation? Evaluation { get; set; }
    private readonly string _id = "uml-" + Guid.NewGuid().ToString("N");
    private bool _zoom;
    private Dictionary<string, UmlBox> Boxes => UmlLayout.Place(Task, Model);
    private int Width => Task.DiagramType == "Sequence" ? Math.Max(560, Model.Nodes.Count * 230 + 70) : Task.DiagramType == "UseCase" ? 820 : Task.DiagramType == "Class" ? 720 : Math.Max(800, Boxes.Count == 0 ? 800 : Boxes.Values.Max(box => box.X + box.Width) + 35);
    private int Height => Task.DiagramType == "Sequence" ? Math.Max(270, Model.Links.Count * 76 + 180) : Math.Max(220, Boxes.Count == 0 ? 220 : Boxes.Values.Max(box => box.Y + box.Height) + 60);
    private string Description => string.Join("; ", Model.Nodes.Select(node => node.Name + ": " + UmlKinds.Nodes.GetValueOrDefault(node.Kind, node.Kind))) + "; " + string.Join("; ", Model.Links.Select(LinkText));
    private bool WrongNode(string id) => Evaluation?.Issues.Any(issue => issue.NodeId == id) == true;
    private bool WrongLink(string id) => Evaluation?.Issues.Any(issue => issue.LinkId == id) == true;
    private static string Short(string value, int maximum = 24) => value.Length > maximum ? value[..(maximum - 1)] + "…" : value;
    private static string MemberText(UmlMember member) => member.Kind is "Entry" or "Do" or "Exit" ? member.Kind.ToLowerInvariant() + " / " + member.Name : member.Visibility + " " + member.Name + (member.Kind == "Method" ? "(" + member.Parameters + ")" : "") + ": " + member.Type;
    private string LinkLabel(UmlLink link) => (link.Kind is "Include" or "Extend" ? "«" + link.Kind.ToLowerInvariant() + "»" : link.Name) + (link.Guard.Length > 0 ? " [" + Task.Conditions.GetValueOrDefault(link.Guard, "?") + "]" : "");
    private string LinkText(UmlLink link) => $"{Model.Nodes.FirstOrDefault(node => node.Id == link.Source)?.Name ?? "?"} → {Model.Nodes.FirstOrDefault(node => node.Id == link.Target)?.Name ?? "?"}: {UmlKinds.Links.GetValueOrDefault(link.Kind, link.Kind)} {LinkLabel(link)}" + (Task.DiagramType == "Class" && link.Kind is "Association" or "Aggregation" or "Composition" ? $"; am Ausgang {link.SourceMultiplicity}, am Ziel {link.TargetMultiplicity}" : "") + (link.Fragment.Length > 0 ? "; Gruppe " + (Task.FragmentVocabulary.GetValueOrDefault(Model.Fragments.FirstOrDefault(item => item.Id == link.Fragment)?.Key ?? "", "?")) : "");
    private string? Marker(UmlLink link) => link.Kind == "Association" ? null : "url(#" + _id + (link.Kind is "Generalization" or "Realization" ? "-triangle" : link.Kind == "Aggregation" ? "-diamond" : link.Kind == "Composition" ? "-filled" : "-arrow") + ")";
    private static (int X1, int Y1, int X2, int Y2) Endpoints(UmlBox a, UmlBox b)
    {
        int x1 = a.X + a.Width / 2, y1 = a.Y + a.Height / 2, x2 = b.X + b.Width / 2, y2 = b.Y + b.Height / 2;
        return Math.Abs(x2 - x1) > Math.Abs(y2 - y1) ? (x1 + Math.Sign(x2 - x1) * a.Width / 2, y1, x2 - Math.Sign(x2 - x1) * b.Width / 2, y2) : (x1, y1 + Math.Sign(y2 - y1) * a.Height / 2, x2, y2 - Math.Sign(y2 - y1) * b.Height / 2);
    }
    /// <summary> Verteilt mehrere Klassenbeziehungen auf getrennte Anschlüsse statt übereinanderliegende Rauten und Mengen. </summary>
    private (int X1, int Y1, int X2, int Y2) ConnectionPoints(UmlLink link, UmlBox a, UmlBox b)
    {
        var p = Endpoints(a, b);
        if (Task.DiagramType != "Class") return p;
        int Offset(string id, int maximum)
        {
            var links = Model.Links.Where(item => item.Source == id || item.Target == id).ToList();
            return Math.Clamp((int)((links.IndexOf(link) - (links.Count - 1) / 2d) * 32), -maximum, maximum);
        }
        if (p.X1 == a.X || p.X1 == a.X + a.Width) p.Y1 += Offset(link.Source, a.Height / 2 - 12); else p.X1 += Offset(link.Source, a.Width / 2 - 12);
        if (p.X2 == b.X || p.X2 == b.X + b.Width) p.Y2 += Offset(link.Target, b.Height / 2 - 12); else p.X2 += Offset(link.Target, b.Width / 2 - 12);
        return p;
    }
    /// <summary> Mengen stehen außerhalb ihres Klassenkastens und werden beim Zeichnen nicht von ihm verdeckt. </summary>
    private static (int X, int Y, string Anchor) MultiplicityLabel(UmlBox box, int x, int y) => x == box.X ? (x - 8, y - 10, "end") : (x + 8, y == box.Y + box.Height ? y + 20 : y - 10, "start");
    /// <summary> Lange alternative Wege laufen außen entlang, damit sie keine fremden Aktionen durchschneiden. </summary>
    private string Path(UmlLink link, UmlBox a, UmlBox b)
    {
        var p = ConnectionPoints(link, a, b);
        if (Task.DiagramType == "Activity" && b.Y - a.Y > 160)
            return $"M{a.X} {a.Y + a.Height / 2} H10 V{b.Y + b.Height / 2} H{b.X}";
        return a == b ? $"M{a.X+a.Width} {a.Y+15} h45 v60 h-45" : $"M{p.X1} {p.Y1} L{p.X2} {p.Y2}";
    }
}
